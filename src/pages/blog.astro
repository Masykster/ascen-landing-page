---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import NewsFeaturedCard from '../components/sections/NewsFeaturedCard.astro';
import { allNews, featuredNews } from '../data/news';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Blog — Ascendemy"
	description="Artikel terbaru seputar TKA, olimpiade, dan dunia pendidikan Indonesia dari Ascendemy."
>
	<Header />

	<main id="main-content">
		<section class="news-hero">
			<div class="container">
				<p class="eyebrow reveal">Blog</p>
				<h1 class="reveal">Artikel terbaru dari dunia pendidikan</h1>
				<p class="lede reveal">
					Artikel seputar TKA, olimpiade, dan tips belajar untuk membantumu mengambil keputusan
					yang tepat.
				</p>
			</div>
		</section>

		<section class="section news-archive">
			<div class="container">
				<div class="archive-head reveal">
					<h2 data-news-title>Semua artikel</h2>
					<span data-news-count>{allNews.length} artikel</span>
				</div>
				<div class="archive-filter" data-news-filter hidden>
					<span class="archive-filter-label">Filter tag</span>
					<strong data-news-filter-tag></strong>
					<a class="archive-filter-clear" href="/blog">Tampilkan semua</a>
				</div>
				<div class="archive-grid" data-stagger data-news-grid>
					{allNews.map((item) => <NewsFeaturedCard {...item} excerpt="" />)}
				</div>
				<p class="archive-empty" data-news-empty hidden>Belum ada artikel yang dipublikasikan.</p>

				<template id="blog-card-template">
					<NewsFeaturedCard {...featuredNews} excerpt="" />
				</template>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script>
	import { articleUrl, fetchCbt, formatDate, type ApiResponse, type CbtNews } from '../lib/cbt-api';

	type NewsPayload = ApiResponse<CbtNews[]>;

	const grid = document.querySelector<HTMLElement>('[data-news-grid]');
	const count = document.querySelector<HTMLElement>('[data-news-count]');
	const title = document.querySelector<HTMLElement>('[data-news-title]');
	const filter = document.querySelector<HTMLElement>('[data-news-filter]');
	const filterTag = document.querySelector<HTMLElement>('[data-news-filter-tag]');
	const empty = document.querySelector<HTMLElement>('[data-news-empty]');
	const template = document.querySelector<HTMLTemplateElement>('#blog-card-template');

	const normalizeTag = (value: string) => value.trim().toLocaleLowerCase('id-ID');
	const activeTag = new URLSearchParams(window.location.search).get('tag')?.trim() ?? '';
	const activeTagKey = normalizeTag(activeTag);

	if (title) {
		title.textContent = activeTag ? `Artikel dengan tag “${activeTag}”` : 'Semua artikel';
	}
	if (filter && filterTag) {
		filterTag.textContent = activeTag;
		filter.hidden = !activeTag;
	}
	if (activeTag) {
		document.title = `Artikel tag “${activeTag}” — Ascendemy`;
		if (count) count.textContent = 'Memuat artikel…';
		if (grid) grid.hidden = true;
	}

	const buildCard = (item: CbtNews) => {
		if (!template) return null;

		const card = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
		if (!card) return null;

		card.setAttribute('href', articleUrl(item.slug));

		const image = card.querySelector<HTMLImageElement>('img');
		if (image) {
			if (item.cover_image_url) {
				image.removeAttribute('srcset');
				image.removeAttribute('sizes');
				image.src = item.cover_image_url;
			}
			image.alt = item.title;
		}

		const meta = Array.from(card.querySelectorAll<HTMLElement>('.news-meta > span:not(.sep)'));
		if (meta[0]) meta[0].textContent = formatDate(item.published_at);
		if (meta[1]) meta[1].textContent = item.category;

		const title = card.querySelector('h3');
		if (title) title.textContent = item.title;

		const pin = card.querySelector<HTMLElement>('.news-pin');
		if (pin) pin.hidden = !item.is_pinned;

		card.classList.add('is-visible');
		return card;
	};

	if (grid && template) {
		void fetchCbt<NewsPayload>('landing/news')
			.then((response) => {
				const items = activeTagKey
					? response.data.filter((item) =>
							(item.tags ?? []).some((tag) => normalizeTag(tag) === activeTagKey),
						)
					: response.data;

				if (count) count.textContent = `${items.length} artikel`;
				grid.replaceChildren();
				grid.hidden = false;
				if (empty) empty.hidden = true;

				if (!items.length) {
					grid.hidden = true;
					if (empty) {
						empty.hidden = false;
						empty.textContent = activeTag
							? `Belum ada artikel dengan tag “${activeTag}”.`
							: 'Belum ada artikel yang dipublikasikan.';
					}
					return;
				}

				items.forEach((item) => {
					const card = buildCard(item);
					if (card) grid.append(card);
				});
			})
			.catch(() => {
				if (!activeTag) return;
				if (grid) grid.hidden = true;
				if (count) count.textContent = '0 artikel';
				if (empty) {
					empty.hidden = false;
					empty.textContent = `Filter tag “${activeTag}” tidak dapat dimuat. Coba lagi.`;
				}
			});
	}
</script>

<style>
	.news-hero {
		position: relative;
		padding: clamp(64px, 8.5vw, 108px) 0 clamp(44px, 5.5vw, 68px);
		background:
			radial-gradient(760px 360px at 88% -20%, rgba(249, 115, 22, 0.08), transparent 70%),
			var(--cream);
		border-bottom: 1px solid var(--line-warm);
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--orange-deep);
	}

	.news-hero h1 {
		margin: 18px 0 0;
		max-width: 800px;
		font-family: var(--font-display);
		font-size: clamp(42px, 6vw, 74px);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--ink);
		text-wrap: balance;
	}

	.lede {
		margin: 20px 0 0;
		max-width: 600px;
		font-size: 17px;
		line-height: 1.65;
		color: var(--muted);
		text-wrap: pretty;
	}

	.news-archive {
		padding: clamp(56px, 7vw, 88px) 0 clamp(72px, 9vw, 112px);
	}

	.archive-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 26px;
	}

	.archive-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(26px, 3.2vw, 38px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.archive-head span {
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		white-space: nowrap;
	}

	.archive-filter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin: -8px 0 24px;
		padding: 10px 12px;
		border: 1px solid var(--line-warm);
		border-radius: 14px;
		background: #fff;
	}

	.archive-filter[hidden] {
		display: none;
	}

	.archive-filter-label {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.archive-filter strong {
		display: inline-flex;
		padding: 5px 10px;
		border-radius: 999px;
		background: var(--cream);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.03em;
	}

	.archive-filter-clear {
		margin-left: auto;
		font-size: 12px;
		font-weight: 700;
		color: var(--orange-deep);
		text-decoration: none;
	}

	.archive-filter-clear:hover {
		color: var(--orange);
	}

	.archive-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.archive-grid[hidden] {
		display: none;
	}

	.archive-empty {
		margin: 0;
		padding: 28px;
		border: 1px dashed var(--line-warm);
		border-radius: var(--radius);
		color: var(--muted);
		text-align: center;
	}

	@media (max-width: 760px) {
		.archive-grid {
			grid-template-columns: 1fr;
		}

		.archive-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 6px;
		}
	}
</style>
