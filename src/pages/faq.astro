---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SlitTypeFaq from '../components/ui/SlitTypeFaq.astro';
import { faqContact, faqItems, faqTicker } from '../data/faq';
import BaseLayout from '../layouts/BaseLayout.astro';

const related = [
	{ label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
	{ label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
];
---

<BaseLayout
	title="Pertanyaan Umum (FAQ) — Ascendemy"
	description="Pertanyaan yang sering diajukan tentang Ascendemy.id: pendaftaran akun, cara membeli paket latihan, tryout, dan kompetisi, pembayaran, masa akses, pengembalian dana, dan jadwal ujian."
>
	<Header />

	<main id="main-content">
		<SlitTypeFaq
			headingTag="h1"
			preset="ascendemy"
			theme="light"
			headline={'Pertanyaan\nUmum'}
			intro="Semua hal penting seputar pendaftaran akun, cara beli paket, metode pembayaran, hingga aturan ujian CBT di Ascendemy."
			ticker={faqTicker}
			search={false}
			copyLinks={false}
			items={faqItems}
			contact={faqContact}
			defaultOpen={0}
			syncHash={true}
		/>

		<section class="faq-related-band" aria-label="Halaman bantuan lainnya">
			<div class="container">
				<nav class="faq-related">
					<span>Bantuan lainnya</span>
					<ul>
						{
							related.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.faq-related-band {
		background: var(--cream);
		padding: 0 0 clamp(56px, 7vw, 88px);
	}

	.faq-related {
		padding-top: 28px;
		border-top: 1px solid rgba(35, 39, 46, 0.16);
	}

	.faq-related > span {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.faq-related ul {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 20px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.faq-related a {
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: rgba(35, 39, 46, 0.28);
		text-underline-offset: 3px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.faq-related a:hover {
		color: var(--orange-deep);
		text-decoration-color: currentColor;
	}
</style>
