---
import { quizQuestions } from '../../data/questions';
import CustomCursor from './CustomCursor.astro';
import Icon from './Icon.astro';

const letters = ['A', 'B', 'C', 'D'];
const total = quizQuestions.length;
---

<div
	class="sim"
	data-sim
	data-cursor-zone
	data-cursor-ripple
	data-questions={JSON.stringify(quizQuestions)}
>
	<div class="sim-top">
		<span class="sim-top-left">Tryout TKA<span class="sim-top-more"> · Matematika</span></span>
		<span class="sim-clock"><Icon name="timer" size={15} /><span data-timer>09:42</span></span>
		<span class="sim-top-right">
			<span class="sim-live"></span>
			<span class="sim-status-label">Ujian Berlangsung</span> · <span data-elapsed>00:00</span>
		</span>
	</div>

	<div class="sim-body">
		<div class="sim-main">
			<div class="sim-meta">
				<div class="sim-meta-id">
					<strong>REG - MATH - SMP - 7 - DAY 7</strong>
					<span data-position>Soal 1 dari {total}</span>
				</div>
				<span class="sim-type">Pilihan Ganda</span>
			</div>

			<div class="sim-questions">
				{
					quizQuestions.map((question, questionIndex) => (
						<div class="sim-question" data-question={questionIndex} hidden={questionIndex !== 0}>
							<p class="sim-label">{question.label}</p>
							{question.formula && <p class="sim-formula">{question.formula}</p>}
							<div class="sim-options">
								{question.options.map((option, optionIndex) => (
									<button
										class="sim-option"
										type="button"
										data-option={optionIndex}
										data-q={questionIndex}
										aria-pressed="false"
									>
										<span class="sim-key">{letters[optionIndex]}</span>
										<span class="sim-value">{option}</span>
										<span class="sim-check">
											<Icon name="check" size={12} />
										</span>
									</button>
								))}
							</div>
						</div>
					))
				}
			</div>

			<div class="sim-actions">
				<button class="sim-action sim-action--prev" type="button" data-prev disabled>
					<Icon name="chev-left" size={14} />
					Sebelumnya
				</button>
				<button class="sim-action sim-action--flag" type="button" data-flag aria-pressed="false">
					<Icon name="flag" size={13} />
					Ragu-ragu
				</button>
				<button class="sim-action sim-action--next" type="button" data-next>
					Selanjutnya
					<Icon name="chev-right" size={14} />
				</button>
			</div>
		</div>

		<aside class="sim-side">
			<div class="sim-side-head">
				<strong>Navigasi Soal</strong>
				<span data-percent>0%</span>
			</div>
			<p class="sim-side-sub">
				<span data-answered>0</span> dari {total} Terjawab
			</p>
			<div class="sim-side-bar"><span data-side-bar></span></div>

			<ul class="sim-legend">
				<li><span class="sim-dot sim-dot--done"></span>Sudah Dijawab</li>
				<li><span class="sim-dot sim-dot--open"></span>Sedang Dibuka</li>
				<li><span class="sim-dot sim-dot--flag"></span>Ragu-ragu</li>
				<li><span class="sim-dot sim-dot--none"></span>Belum Dijawab</li>
			</ul>

			<div class="sim-tiles" data-nav>
				{
					quizQuestions.map((_, index) => (
						<button
							class="sim-tile"
							type="button"
							data-tile={index}
							aria-label={`Buka soal ${index + 1}`}
						>
							{index + 1}
						</button>
					))
				}
			</div>
		</aside>
	</div>

	<CustomCursor ripple />
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-sim]');

	if (root) {
		const questions = JSON.parse(root.dataset.questions ?? '[]') as {
			label: string;
			formula?: string;
			options: string[];
		}[];
		const total = questions.length;

		const positionEl = root.querySelector<HTMLElement>('[data-position]');
		const answeredEl = root.querySelector<HTMLElement>('[data-answered]');
		const percentEl = root.querySelector<HTMLElement>('[data-percent]');
		const sideBarEl = root.querySelector<HTMLElement>('[data-side-bar]');
		const prevEl = root.querySelector<HTMLButtonElement>('[data-prev]');
		const nextEl = root.querySelector<HTMLButtonElement>('[data-next]');
		const flagEl = root.querySelector<HTMLButtonElement>('[data-flag]');
		const questionBlocks = Array.from(root.querySelectorAll<HTMLElement>('[data-question]'));
		const optionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-option]'));
		const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tile]'));

		const answers = new Array<number>(total).fill(-1);
		const flagged = new Array<boolean>(total).fill(false);
		let current = 0;

		function render() {
			questionBlocks.forEach((block, index) => {
				block.hidden = index !== current;
			});

			optionButtons.forEach((button) => {
				const questionIndex = Number(button.dataset.q);
				const optionIndex = Number(button.dataset.option);
				const selected = answers[questionIndex] === optionIndex;
				button.classList.toggle('is-selected', selected);
				button.setAttribute('aria-pressed', selected ? 'true' : 'false');
			});

			tiles.forEach((tile, index) => {
				tile.classList.toggle('is-current', index === current);
				tile.classList.toggle('is-flagged', flagged[index]);
				tile.classList.toggle('is-done', answers[index] !== -1);
			});

			const answered = answers.filter((answer) => answer !== -1).length;
			const percent = Math.round((answered / total) * 100);

			if (positionEl) positionEl.textContent = `Soal ${current + 1} dari ${total}`;
			if (answeredEl) answeredEl.textContent = String(answered);
			if (percentEl) percentEl.textContent = `${percent}%`;
			if (sideBarEl) sideBarEl.style.width = `${percent}%`;

			prevEl?.toggleAttribute('disabled', current === 0);
			nextEl?.toggleAttribute('disabled', current === total - 1);

			const isFlagged = flagged[current];
			flagEl?.classList.toggle('is-active', isFlagged);
			flagEl?.setAttribute('aria-pressed', isFlagged ? 'true' : 'false');
		}

		optionButtons.forEach((button) => {
			button.addEventListener('click', () => {
				answers[Number(button.dataset.q)] = Number(button.dataset.option);
				render();
			});
		});

		tiles.forEach((tile, index) => {
			tile.addEventListener('click', () => {
				current = index;
				render();
			});
		});

		prevEl?.addEventListener('click', () => {
			if (current > 0) {
				current -= 1;
				render();
			}
		});

		nextEl?.addEventListener('click', () => {
			if (current < total - 1) {
				current += 1;
				render();
			}
		});

		flagEl?.addEventListener('click', () => {
			flagged[current] = !flagged[current];
			render();
		});

		render();

		// Timer mundur + durasi berjalan
		const timerEl = root.querySelector<HTMLElement>('[data-timer]');
		const elapsedEl = root.querySelector<HTMLElement>('[data-elapsed]');
		let remaining = 9 * 60 + 42;
		let elapsed = 0;
		let timerId: number | null = null;

		function tick() {
			remaining = Math.max(0, remaining - 1);
			elapsed += 1;

			if (timerEl) {
				const minutes = String(Math.floor(remaining / 60)).padStart(2, '0');
				const seconds = String(remaining % 60).padStart(2, '0');
				timerEl.textContent = `${minutes}:${seconds}`;
			}

			if (elapsedEl) {
				const minutes = String(Math.floor(elapsed / 60)).padStart(2, '0');
				const seconds = String(elapsed % 60).padStart(2, '0');
				elapsedEl.textContent = `${minutes}:${seconds}`;
			}
		}

		if (timerEl) {
			timerId = window.setInterval(tick, 1000);
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) {
					if (timerId !== null) window.clearInterval(timerId);
					timerId = null;
				} else if (timerId === null) {
					timerId = window.setInterval(tick, 1000);
				}
			});
		}

	}
</script>

<style>
	.sim {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		background:
			radial-gradient(560px 320px at 95% -12%, #eef4ff 0%, rgba(238, 244, 255, 0) 70%),
			linear-gradient(180deg, #ffffff 0%, #fbfaf8 100%);
	}

	/* --- top bar ----------------------------------------------------------- */

	.sim-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		padding: 0 20px;
		height: 46px;
		border-bottom: 1px solid #ece7df;
		background: rgba(255, 255, 255, 0.72);
	}

	.sim-top-left {
		font-size: 12px;
		font-weight: 700;
		color: var(--ink);
	}

	.sim-clock {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #ece7df;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
	}

	.sim-clock :global(svg) {
		width: 15px;
		height: 15px;
		color: #8a8f99;
	}

	.sim-top-right {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		justify-self: end;
		font-size: 11px;
		font-weight: 600;
		color: #7f8593;
	}

	.sim-live {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #46a758;
		box-shadow: 0 0 0 4px rgba(70, 167, 88, 0.16);
		animation: sim-pulse 2.2s ease-in-out infinite;
	}

	@keyframes sim-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(70, 167, 88, 0.35);
		}

		50% {
			box-shadow: 0 0 0 6px rgba(70, 167, 88, 0);
		}
	}

	/* --- body -------------------------------------------------------------- */

	.sim-body {
		flex: 1;
		display: flex;
		gap: 18px;
		padding: 18px 20px 20px;
		min-height: 0;
	}

	.sim-main {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.sim-meta {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px;
	}

	.sim-meta-id strong {
		display: block;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--ink);
	}

	.sim-meta-id span {
		display: block;
		margin-top: 3px;
		font-size: 12px;
		color: var(--muted);
	}

	.sim-type {
		font-size: 12px;
		font-weight: 700;
		color: var(--blue);
	}

	.sim-questions {
		flex: 1;
		min-height: 0;
		display: flex;
	}

	.sim-question {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.sim-question[hidden] {
		display: none;
	}

	.sim-label {
		margin: 0;
		font-size: 15px;
		color: var(--text);
	}

	.sim-formula {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 21px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.sim-options {
		flex: 1;
		min-height: 0;
		display: grid;
		grid-template-rows: repeat(4, minmax(0, 62px));
		align-content: space-evenly;
		gap: 10px;
	}

	.sim-option {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px 16px;
		border: 1px solid #e8e3db;
		border-radius: 12px;
		background: #fff;
		text-align: left;
		font-family: inherit;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.sim-option:hover {
		transform: translateY(-2px);
		border-color: #c9d8f5;
		box-shadow: 0 14px 26px -20px rgba(35, 39, 46, 0.55);
	}

	.sim-option.is-selected {
		border-color: var(--blue);
		background: #f4f8ff;
		box-shadow: 0 14px 26px -20px rgba(37, 99, 235, 0.9);
	}

	.sim-key {
		width: 30px;
		height: 30px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #f1f2f5;
		color: #8a8f99;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.sim-option.is-selected .sim-key {
		background: var(--blue);
		color: #fff;
	}

	.sim-value {
		flex: 1;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
	}

	.sim-check {
		width: 22px;
		height: 22px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--blue);
		color: #fff;
		opacity: 0;
		transform: scale(0.5);
		transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.4);
	}

	.sim-check :global(svg) {
		width: 12px;
		height: 12px;
	}

	.sim-option.is-selected .sim-check {
		opacity: 1;
		transform: scale(1);
	}

	/* --- action bar -------------------------------------------------------- */

	.sim-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 14px;
		border: 1px solid #ece7df;
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 16px 30px -28px rgba(35, 39, 46, 0.5);
	}

	.sim-action {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 9px 16px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		font-family: inherit;
		font-size: 12.5px;
		font-weight: 700;
		color: var(--ink);
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.sim-action :global(svg) {
		width: 14px;
		height: 14px;
	}

	.sim-action--prev:disabled {
		color: #b6bac2;
		background: #f4f5f7;
	}

	.sim-action--flag {
		color: #b7791f;
		border-color: #f3e3bd;
		background: #fdf8ec;
	}

	.sim-action--flag:hover {
		background: #fbf1d8;
	}

	.sim-action--flag.is-active {
		background: #f6c453;
		border-color: #e8ae2f;
		color: #6b4a08;
	}

	.sim-action--next {
		background: var(--blue);
		color: #fff;
		box-shadow: 0 12px 22px -14px rgba(37, 99, 235, 0.9);
	}

	.sim-action--next:hover:not(:disabled) {
		background: #1d4ed8;
	}

	.sim-action--next:disabled {
		background: #eef0f4;
		color: #a9aeb8;
		box-shadow: none;
	}

	/* --- navigasi soal ----------------------------------------------------- */

	.sim-side {
		width: 268px;
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 16px;
		border: 1px solid #ece7df;
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 18px 34px -30px rgba(35, 39, 46, 0.5);
	}

	.sim-side-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.sim-side-head strong {
		font-size: 13px;
		font-weight: 800;
		color: var(--ink);
	}

	.sim-side-head span {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--blue);
	}

	.sim-side-sub {
		margin: 0;
		font-size: 11px;
		color: var(--muted);
	}

	.sim-side-bar {
		height: 6px;
		border-radius: 999px;
		background: #eef0f3;
		overflow: hidden;
	}

	.sim-side-bar span {
		display: block;
		width: 0;
		height: 100%;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--blue), #60a5fa);
		transition: width 0.45s cubic-bezier(0.22, 0.8, 0.28, 1);
	}

	.sim-legend {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 7px 10px;
		margin: 4px 0 2px;
		padding: 10px;
		list-style: none;
		border-radius: 10px;
		background: #f7f8fa;
	}

	.sim-legend li {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 10px;
		font-weight: 600;
		color: #6b7280;
	}

	.sim-dot {
		width: 8px;
		height: 8px;
		flex: 0 0 auto;
		border-radius: 50%;
	}

	.sim-dot--done {
		background: #46a758;
	}

	.sim-dot--open {
		background: var(--blue);
	}

	.sim-dot--flag {
		background: #f0b429;
	}

	.sim-dot--none {
		background: #d7dae0;
	}

	.sim-tiles {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 8px;
		margin-top: auto;
	}

	.sim-tile {
		height: 38px;
		display: grid;
		place-items: center;
		border: 1px solid transparent;
		border-radius: 10px;
		background: #eef0f3;
		color: #6b7280;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.sim-tile:hover {
		border-color: #c9d8f5;
		color: var(--blue);
	}

	.sim-tile.is-done {
		background: #e6f5ea;
		color: #2f8f45;
	}

	.sim-tile.is-flagged {
		background: #fdf3d8;
		color: #b7791f;
	}

	.sim-tile.is-current {
		background: var(--blue);
		color: #fff;
		box-shadow: 0 10px 18px -12px rgba(37, 99, 235, 0.95);
	}

	@media (max-width: 900px) {
		.sim-side {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.sim-top {
			height: 36px;
			padding: 0 12px;
			gap: 8px;
		}

		.sim-top-left {
			font-size: 10px;
		}

		.sim-top-more,
		.sim-status-label {
			display: none;
		}

		.sim-clock {
			padding: 3px 9px;
			font-size: 12px;
		}

		.sim-clock :global(svg) {
			width: 12px;
			height: 12px;
		}

		.sim-top-right {
			font-size: 9px;
		}

		.sim-body {
			padding: 12px 14px 14px;
			gap: 10px;
		}

		.sim-main {
			gap: 8px;
		}

		.sim-meta-id strong {
			font-size: 9px;
		}

		.sim-meta-id span {
			font-size: 10px;
		}

		.sim-type {
			font-size: 10px;
		}

		.sim-question {
			gap: 6px;
		}

		.sim-label {
			font-size: 11px;
		}

		.sim-formula {
			font-size: 15px;
		}

		.sim-options {
			grid-template-rows: none;
			grid-template-columns: 1fr 1fr;
			gap: 6px;
		}

		.sim-option {
			gap: 7px;
			padding: 6px 8px;
			border-radius: 9px;
		}

		.sim-key {
			width: 18px;
			height: 18px;
			font-size: 9px;
		}

		.sim-value {
			font-size: 10.5px;
		}

		.sim-check {
			width: 15px;
			height: 15px;
		}

		.sim-check :global(svg) {
			width: 9px;
			height: 9px;
		}

		.sim-actions {
			padding: 5px 8px;
			border-radius: 10px;
		}

		.sim-action {
			padding: 6px 9px;
			font-size: 9.5px;
			gap: 4px;
		}

		.sim-action :global(svg) {
			width: 11px;
			height: 11px;
		}
	}
</style>
