---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { quizQuestions } from '../../data/questions';
import CustomCursor from './CustomCursor.astro';
import ExamFigure from './ExamFigure.astro';
import Icon from './Icon.astro';

const letters = ['A', 'B', 'C', 'D'];
const total = quizQuestions.length;
const first = quizQuestions[0];
---

<div class="sim" data-sim data-cursor-zone data-cursor-ripple>
	<header class="sim-top">
		<div class="sim-brand">
			<Image src={logo} alt="Ascendemy" widths={[72, 144, 216]} sizes="72px" format="webp" class="sim-logo" />
			<span class="sim-brand-text">
				<strong>Tryout TKA SMP<span class="sim-top-more"> · Matematika</span></strong>
				<code>PKT-TKA-SMP-MTK-07</code>
			</span>
		</div>

		<span class="sim-clock">
			<Icon name="timer" size={15} />
			<span class="sim-clock-label">Sisa waktu</span>
			<span data-timer>01:14:52</span>
		</span>

		<div class="sim-user">
			<span class="sim-avatar" aria-hidden="true">RA</span>
			<span class="sim-user-id">
				<strong>Rafi Aditya</strong>
				<small>26-0417-0731</small>
			</span>
			<button class="sim-finish" type="button" data-finish>
				Selesai<span class="sim-finish-more"> Ujian</span>
			</button>
		</div>
	</header>

	<div class="sim-body">
		<div class="sim-main">
			<div class="sim-meta">
				<span class="sim-no">Soal No. <b data-number>1</b></span>
				<span class="sim-topic" data-topic>{first.topic} · Pilihan Ganda</span>
				<div class="sim-font" role="group" aria-label="Ukuran teks soal">
					<button type="button" data-font="0.92" aria-pressed="false" aria-label="Perkecil teks">A-</button>
					<button type="button" data-font="1" aria-pressed="true" aria-label="Ukuran teks normal">A</button>
					<button type="button" data-font="1.1" aria-pressed="false" aria-label="Perbesar teks">A+</button>
				</div>
			</div>

			<div class="sim-questions" data-questions>
				{
					quizQuestions.map((question, questionIndex) => (
						<div
							class:list={['sim-question', question.figure && 'has-figure']}
							data-question={questionIndex}
							data-topic={question.topic}
							data-answer={question.answer}
							hidden={questionIndex !== 0}
						>
							<div class="sim-prompt">
								<div class="sim-prompt-text">
									<p class="sim-stem" set:html={question.stem} />
									{question.formula && <p class="sim-formula" set:html={question.formula} />}
								</div>
								{question.figure && <ExamFigure name={question.figure} />}
							</div>
							<div class="sim-options">
								{question.options.map((option, optionIndex) => (
									<button
										class="sim-option"
										type="button"
										data-option={optionIndex}
										data-q={questionIndex}
										aria-pressed="false"
									>
										<span class="sim-key">{letters[optionIndex]}</span>
										<span class="sim-value" set:html={option} />
										<span class="sim-check">
											<Icon name="check" size={12} />
										</span>
									</button>
								))}
							</div>
						</div>
					))
				}
			</div>

			<div class="sim-actions">
				<button class="sim-action sim-action--prev" type="button" data-prev disabled>
					<Icon name="chev-left" size={14} />
					Sebelumnya
				</button>
				<button class="sim-action sim-action--flag" type="button" data-flag aria-pressed="false">
					<Icon name="flag" size={13} />
					Ragu-ragu
				</button>
				<button class="sim-action sim-action--next" type="button" data-next>
					Selanjutnya
					<Icon name="chev-right" size={14} />
				</button>
			</div>
		</div>

		<aside class="sim-side">
			<div class="sim-side-head">
				<strong>Navigasi Soal</strong>
				<span data-percent>0%</span>
			</div>
			<p class="sim-side-sub">
				<span data-answered>0</span> dari {total} Terjawab
			</p>
			<div class="sim-side-bar"><span data-side-bar></span></div>

			<ul class="sim-legend">
				<li><span class="sim-dot sim-dot--done"></span>Sudah Dijawab</li>
				<li><span class="sim-dot sim-dot--open"></span>Sedang Dibuka</li>
				<li><span class="sim-dot sim-dot--flag"></span>Ragu-ragu</li>
				<li><span class="sim-dot sim-dot--none"></span>Belum Dijawab</li>
			</ul>

			<div class="sim-tiles" data-nav>
				{
					quizQuestions.map((_, index) => (
						<button
							class="sim-tile"
							type="button"
							data-tile={index}
							aria-label={`Buka soal ${index + 1}`}
						>
							{index + 1}
						</button>
					))
				}
			</div>
		</aside>
	</div>

	<div class="sim-toast" data-toast role="status" hidden>
		<span>Ini simulasi demo.</span>
		<a href="https://cbt.ascendemy.id/register">Daftar gratis untuk tryout lengkap →</a>
	</div>

	<span class="sim-ghost" data-ghost aria-hidden="true">
		<img src="/cursor-alt-pointer-mouse.svg" width="20" height="20" alt="" />
	</span>

	<CustomCursor ripple />
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-sim]');

	if (root) {
		const questionBlocks = Array.from(root.querySelectorAll<HTMLElement>('[data-question]'));
		const total = questionBlocks.length;

		const numberEl = root.querySelector<HTMLElement>('[data-number]');
		const topicEl = root.querySelector<HTMLElement>('[data-topic]');
		const questionsEl = root.querySelector<HTMLElement>('[data-questions]');
		const answeredEl = root.querySelector<HTMLElement>('[data-answered]');
		const percentEl = root.querySelector<HTMLElement>('[data-percent]');
		const sideBarEl = root.querySelector<HTMLElement>('[data-side-bar]');
		const prevEl = root.querySelector<HTMLButtonElement>('[data-prev]');
		const nextEl = root.querySelector<HTMLButtonElement>('[data-next]');
		const flagEl = root.querySelector<HTMLButtonElement>('[data-flag]');
		const finishEl = root.querySelector<HTMLButtonElement>('[data-finish]');
		const toastEl = root.querySelector<HTMLElement>('[data-toast]');
		const ghostEl = root.querySelector<HTMLElement>('[data-ghost]');
		const optionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-option]'));
		const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tile]'));
		const fontButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-font]'));

		const answers = new Array<number>(total).fill(-1);
		const flagged = new Array<boolean>(total).fill(false);
		let current = 0;
		let shown = 0;

		function render() {
			questionBlocks.forEach((block, index) => {
				block.hidden = index !== current;
			});

			// soal baru dibuka → gulir area soal kembali ke atas
			if (shown !== current && questionsEl) questionsEl.scrollTop = 0;
			shown = current;

			optionButtons.forEach((button) => {
				const questionIndex = Number(button.dataset.q);
				const optionIndex = Number(button.dataset.option);
				const selected = answers[questionIndex] === optionIndex;
				button.classList.toggle('is-selected', selected);
				button.setAttribute('aria-pressed', selected ? 'true' : 'false');
			});

			tiles.forEach((tile, index) => {
				tile.classList.toggle('is-current', index === current);
				tile.classList.toggle('is-flagged', flagged[index]);
				tile.classList.toggle('is-done', answers[index] !== -1);
			});

			const answered = answers.filter((answer) => answer !== -1).length;
			const percent = Math.round((answered / total) * 100);

			if (numberEl) numberEl.textContent = String(current + 1);
			if (topicEl) topicEl.textContent = `${questionBlocks[current].dataset.topic} · Pilihan Ganda`;
			if (answeredEl) answeredEl.textContent = String(answered);
			if (percentEl) percentEl.textContent = `${percent}%`;
			if (sideBarEl) sideBarEl.style.width = `${percent}%`;

			prevEl?.toggleAttribute('disabled', current === 0);
			nextEl?.toggleAttribute('disabled', current === total - 1);

			const isFlagged = flagged[current];
			flagEl?.classList.toggle('is-active', isFlagged);
			flagEl?.setAttribute('aria-pressed', isFlagged ? 'true' : 'false');
		}

		optionButtons.forEach((button) => {
			button.addEventListener('click', () => {
				answers[Number(button.dataset.q)] = Number(button.dataset.option);
				render();
			});
		});

		tiles.forEach((tile, index) => {
			tile.addEventListener('click', () => {
				current = index;
				render();
			});
		});

		prevEl?.addEventListener('click', () => {
			if (current > 0) {
				current -= 1;
				render();
			}
		});

		nextEl?.addEventListener('click', () => {
			if (current < total - 1) {
				current += 1;
				render();
			}
		});

		flagEl?.addEventListener('click', () => {
			flagged[current] = !flagged[current];
			render();
		});

		// Ukuran teks soal (A- / A / A+)
		fontButtons.forEach((button) => {
			button.addEventListener('click', () => {
				questionsEl?.style.setProperty('--q-scale', button.dataset.font ?? '1');
				fontButtons.forEach((other) =>
					other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
				);
			});
		});

		// "Selesai Ujian" → toast CTA (simulator ini hanya demo)
		let toastTimer = 0;
		finishEl?.addEventListener('click', () => {
			if (!toastEl) return;
			toastEl.hidden = false;
			window.clearTimeout(toastTimer);
			toastTimer = window.setTimeout(() => {
				toastEl.hidden = true;
			}, 5000);
		});

		render();

		// Timer mundur (hh:mm:ss)
		const timerEl = root.querySelector<HTMLElement>('[data-timer]');
		let remaining = 1 * 3600 + 14 * 60 + 52;
		let timerId: number | null = null;

		const pad = (value: number) => String(value).padStart(2, '0');

		function tick() {
			remaining = Math.max(0, remaining - 1);
			if (timerEl) {
				const hours = Math.floor(remaining / 3600);
				const minutes = Math.floor((remaining % 3600) / 60);
				timerEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(remaining % 60)}`;
			}
		}

		if (timerEl) {
			timerId = window.setInterval(tick, 1000);
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) {
					if (timerId !== null) window.clearInterval(timerId);
					timerId = null;
				} else if (timerId === null) {
					timerId = window.setInterval(tick, 1000);
				}
			});
		}

		// --- Mode demo: kursor "siswa demo" mengerjakan soal saat pengunjung diam ---
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (ghostEl && !reduceMotion) {
			const ghost = ghostEl;
			const STOP = Symbol('demo-stop');

			let session = 0;
			let running = false;
			let visible = false;
			let pointerInside = false;
			let placed = false;
			let startTimer = 0;
			let ghostX = 0;
			let ghostY = 0;

			const rand = (min: number, max: number) => min + Math.random() * (max - min);
			const isShown = (el: HTMLElement) => el.offsetParent !== null;

			const sleep = (ms: number, s: number) =>
				new Promise<void>((resolve, reject) => {
					window.setTimeout(() => (s === session ? resolve() : reject(STOP)), ms);
				});

			const placeGhost = (x: number, y: number, duration: number) => {
				ghost.style.transitionDuration = `${duration}ms, 250ms`;
				ghost.style.transform = `translate3d(${x - 3}px, ${y - 2}px, 0)`;
				ghostX = x;
				ghostY = y;
			};

			async function moveTo(el: HTMLElement, s: number, linger = 0) {
				const box = root!.getBoundingClientRect();
				const rect = el.getBoundingClientRect();
				const x = rect.left - box.left + rect.width * rand(0.3, 0.62);
				const y = rect.top - box.top + rect.height * rand(0.38, 0.66);
				const duration = Math.round(Math.min(950, 360 + Math.hypot(x - ghostX, y - ghostY) * 0.9));
				placeGhost(x, y, duration);
				await sleep(duration + 90 + linger, s);
			}

			async function clickEl(el: HTMLElement, s: number) {
				await moveTo(el, s);
				ghost.classList.add('is-pressing');

				const ripple = document.createElement('span');
				ripple.className = 'cursor-ripple';
				ripple.style.left = `${ghostX}px`;
				ripple.style.top = `${ghostY}px`;
				root!.appendChild(ripple);
				window.setTimeout(() => ripple.remove(), 620);

				await sleep(130, s);
				ghost.classList.remove('is-pressing');
				el.click();
				await sleep(240, s);
			}

			/** buka soal tertentu lewat tile navigasi, atau tombol prev/next jika panel tersembunyi (mobile) */
			async function goToQuestion(index: number, s: number) {
				const tile = tiles[index];
				if (tile && isShown(tile)) {
					await clickEl(tile, s);
					return;
				}
				while (current !== index) {
					const step = current < index ? nextEl : prevEl;
					if (!step) return;
					await clickEl(step, s);
					await sleep(260, s);
				}
			}

			function resetState() {
				answers.fill(-1);
				flagged.fill(false);
				current = 0;
				render();
			}

			async function runDemo(s: number) {
				while (true) {
					// semua terjawab → periksa ulang soal ragu-ragu, lalu ulangi dari awal
					if (answers.every((answer) => answer !== -1)) {
						const doubtful = flagged.findIndex(Boolean);
						if (doubtful !== -1) {
							await sleep(700, s);
							await goToQuestion(doubtful, s);
							await sleep(1200, s);
							if (flagEl) await clickEl(flagEl, s);
							await sleep(1800, s);
							continue;
						}
						await sleep(2600, s);
						resetState();
						await sleep(900, s);
						continue;
					}

					const target = answers.findIndex((answer) => answer === -1);
					if (target !== current) {
						await goToQuestion(target, s);
						await sleep(400, s);
					}

					const block = questionBlocks[current];
					const options = Array.from(block.querySelectorAll<HTMLButtonElement>('[data-option]'));
					const correct = Number(block.dataset.answer);

					// waktu "membaca" menyesuaikan panjang soal
					const textLength = block.querySelector('.sim-prompt')?.textContent?.trim().length ?? 40;
					await sleep(Math.min(2400, 900 + textLength * 9), s);

					// ±80% benar, sisanya keliru — seperti siswa sungguhan
					let choice = correct;
					if (Math.random() > 0.8) {
						const wrong = options.map((_, i) => i).filter((i) => i !== correct);
						choice = wrong[Math.floor(Math.random() * wrong.length)];
					}

					// kadang menimbang opsi lain dulu
					if (Math.random() < 0.3) {
						const others = options.filter((_, i) => i !== choice);
						await moveTo(others[Math.floor(Math.random() * others.length)], s, 420);
					}

					await clickEl(options[choice], s);

					// soal bergambar pertama ditandai ragu-ragu untuk diperiksa ulang nanti
					if (current === 2 && !flagged[2] && flagEl) {
						await sleep(380, s);
						await clickEl(flagEl, s);
					}

					await sleep(520, s);
					if (current < total - 1 && nextEl) await clickEl(nextEl, s);
				}
			}

			function begin() {
				if (running || !visible || document.hidden || pointerInside) return;
				running = true;
				const s = ++session;

				if (!placed) {
					// mulai dari area kosong kanan-bawah kolom soal
					const box = root!.getBoundingClientRect();
					placeGhost(box.width * 0.55, box.height * 0.82, 0);
					placed = true;
				}

				ghost.classList.add('is-visible');
				runDemo(s).catch((error) => {
					if (error !== STOP) console.error(error);
				});
			}

			function halt() {
				window.clearTimeout(startTimer);
				if (!running) return;
				running = false;
				session += 1;
				ghost.classList.remove('is-visible', 'is-pressing');
			}

			const scheduleStart = (delay: number) => {
				window.clearTimeout(startTimer);
				startTimer = window.setTimeout(begin, delay);
			};

			// pengunjung mengambil alih → demo berhenti, state dipertahankan
			const takeOver = (event: Event, resumeAfter: number) => {
				if (!event.isTrusted) return;
				halt();
				scheduleStart(resumeAfter);
			};

			root.addEventListener('pointermove', (event) => {
				if (!event.isTrusted || event.pointerType !== 'mouse') return;
				pointerInside = true;
				halt();
			});
			root.addEventListener('pointerleave', (event) => {
				if (event.pointerType !== 'mouse') return;
				pointerInside = false;
				scheduleStart(6000);
			});
			root.addEventListener('pointerdown', (event) => takeOver(event, 8000));
			root.addEventListener('touchstart', (event) => takeOver(event, 8000), { passive: true });
			root.addEventListener('keydown', (event) => takeOver(event, 6000));

			new IntersectionObserver(
				([entry]) => {
					visible = entry.isIntersecting;
					if (visible) scheduleStart(1800);
					else halt();
				},
				{ threshold: 0.35 },
			).observe(root);

			document.addEventListener('visibilitychange', () => {
				if (document.hidden) halt();
				else scheduleStart(1800);
			});
		}
	}
</script>

<style>
	.sim {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		background:
			radial-gradient(560px 320px at 95% -12%, #eef4ff 0%, rgba(238, 244, 255, 0) 70%),
			linear-gradient(180deg, #ffffff 0%, #fbfaf8 100%);
	}

	/* --- header aplikasi ---------------------------------------------------- */

	.sim-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		padding: 0 18px;
		height: 54px;
		border-bottom: 1px solid #ece7df;
		background: rgba(255, 255, 255, 0.86);
	}

	.sim-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.sim-brand :global(.sim-logo) {
		width: 72px;
		height: auto;
		flex: 0 0 auto;
	}

	.sim-brand-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		padding-left: 10px;
		border-left: 1px solid #ece7df;
	}

	.sim-brand-text strong {
		font-size: 12px;
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sim-brand-text code {
		font-family: var(--font-mono);
		font-size: 9.5px;
		letter-spacing: 0.04em;
		color: #8a8f99;
	}

	.sim-clock {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #ece7df;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
		box-shadow: 0 8px 18px -16px rgba(35, 39, 46, 0.6);
	}

	.sim-clock :global(svg) {
		width: 15px;
		height: 15px;
		color: var(--blue);
	}

	.sim-clock-label {
		font-family: var(--font-body, inherit);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0;
		color: #8a8f99;
	}

	.sim-user {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		justify-self: end;
		min-width: 0;
	}

	.sim-avatar {
		width: 28px;
		height: 28px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--blue) 0%, #60a5fa 100%);
		color: #fff;
		font-size: 10.5px;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.sim-user-id {
		display: flex;
		flex-direction: column;
		gap: 1px;
		line-height: 1.15;
	}

	.sim-user-id strong {
		font-size: 11.5px;
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
	}

	.sim-user-id small {
		font-family: var(--font-mono);
		font-size: 9.5px;
		color: #8a8f99;
	}

	.sim-finish {
		margin-left: 4px;
		padding: 7px 12px;
		border: 1px solid #f8c9a8;
		border-radius: 999px;
		background: #fff5ee;
		color: var(--orange-deep);
		font-family: inherit;
		font-size: 11.5px;
		font-weight: 700;
		white-space: nowrap;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.sim-finish:hover {
		background: var(--orange);
		border-color: var(--orange);
		color: #fff;
	}

	/* --- body -------------------------------------------------------------- */

	.sim-body {
		flex: 1;
		display: flex;
		gap: 18px;
		padding: 16px 20px 20px;
		min-height: 0;
	}

	.sim-main {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	/* --- baris info soal --------------------------------------------------- */

	.sim-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		padding-bottom: 10px;
		border-bottom: 1px dashed #ece7df;
	}

	.sim-no {
		flex: 0 0 auto;
		padding: 5px 11px;
		border-radius: 8px;
		background: var(--blue);
		color: #fff;
		font-size: 11.5px;
		font-weight: 700;
		box-shadow: 0 8px 16px -12px rgba(37, 99, 235, 0.9);
	}

	.sim-no b {
		font-family: var(--font-mono);
	}

	.sim-topic {
		flex: 1;
		min-width: 0;
		font-size: 11.5px;
		font-weight: 600;
