---
export type HighlightVariant = 'lime' | 'yellow' | 'pink' | 'cyan' | 'orange';

interface Props {
	variant?: HighlightVariant;
	class?: string;
}

const { variant = 'lime', class: className = '' } = Astro.props;
---

<span class="ht">
	<span class:list={['ht-bg', `ht-bg--${variant}`, className]} aria-hidden="true"></span>
	<span class="ht-text"><slot /></span>
</span>

<style>
	.ht {
		position: relative;
		display: inline-block;
		margin: 0 0.08em;
	}

	.ht-bg {
		position: absolute;
		inset: 0;
		border-radius: 2px;
		transform: scaleX(1.08) scaleY(0.9) skewY(-1deg);
		pointer-events: none;
	}

	.ht-bg--lime {
		background-color: var(--accent-green, #c5f83a);
	}

	.ht-bg--yellow {
		background-color: #fde047;
	}

	.ht-bg--pink {
		background-color: #f9a8d4;
	}

	.ht-bg--cyan {
		background-color: #67e8f9;
	}

	.ht-bg--orange {
		background-color: #fdba74;
	}

	.ht-text {
		position: relative;
		z-index: 1;
		color: var(--ink);
		font-weight: 600;
	}
</style>
