---
import CustomCursor from './CustomCursor.astro';
import Icon from './Icon.astro';

interface PracticeRow {
	label: string;
	value: number;
}

interface Props {
	title: string;
	subtitle?: string;
	badge: string;
	chips: string[];
	rows: PracticeRow[];
	footer?: { left: string; right: string };
	compact?: boolean;
	progress?: number;
	recommendation?: string;
}

const {
	title,
	subtitle,
	badge,
	chips,
	rows,
	footer,
	compact = false,
	progress = 0,
	recommendation = 'Peluang · 5 soal lagi',
} = Astro.props;

const RING_C = 2 * Math.PI * 24;
const ringOffset = RING_C * (1 - Math.min(Math.max(progress, 0), 100) / 100);
---

<div
	class:list={['practice', compact ? 'mock-panel practice--compact' : 'practice-shell practice--full']}
	data-cursor-zone={compact ? '' : undefined}
>
	{compact && <CustomCursor />}
	{
		compact ? (
			<>
				<div class="mock-head">
					<span class="mock-title">{title}</span>
					<span class="mock-tag">{badge}</span>
				</div>

				<div class="practice-chips">
					{chips.map((chip) => (
						<span class="chip">{chip}</span>
					))}
				</div>

				<div class="practice-rows">
					{rows.map((row, index) => (
						<div class="practice-row" style={`--d:${index * 90}ms`}>
							<span class="practice-label">{row.label}</span>
							<span class="practice-meta">{row.value}%</span>
							<span class="practice-bar">
								<span style={`--v:${row.value / 100}`} />
							</span>
						</div>
					))}
				</div>

				{progress > 0 && <p class="practice-caption">{progress}% materi dikuasai · soal adaptif</p>}
			</>
		) : (
			<>
				<div class="panel-status">
					<span class="status-dot" />
					<span class="status-label">Sesi belajar</span>
					<span class="status-meta">Minggu 3</span>
				</div>

				<div class="practice-head">
					<div class="head-text">
						<h3>{title}</h3>
						{subtitle && <p>{subtitle}</p>}
					</div>

					{progress > 0 && (
						<div class="practice-ring" style={`--c:${RING_C}; --off:${ringOffset}`}>
							<svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
								<circle class="ring-track" cx="28" cy="28" r="24" />
								<circle class="ring-progress" cx="28" cy="28" r="24" />
							</svg>
							<span class="ring-label">{progress}%</span>
						</div>
					)}
				</div>

				<div class="practice-chips">
					{chips.map((chip) => (
						<span class="chip">{chip}</span>
					))}
				</div>

				<div class="practice-rec">
					<span class="rec-icon">
						<Icon name="spark" size={12} />
					</span>
					<span class="rec-label">Rekomendasi hari ini</span>
					<span class="rec-value">{recommendation}</span>
				</div>

				<div class="practice-rows">
					{rows.map((row, index) => (
						<div class="practice-row" style={`--d:${index * 90}ms`}>
							<span class="practice-label">{row.label}</span>
							<span class="practice-meta">{row.value}%</span>
							<span class="practice-bar">
								<span style={`--v:${row.value / 100}`} />
							</span>
						</div>
					))}
				</div>

				{footer && (
					<div class="practice-foot">
						<span>{footer.left}</span>
						<span>{footer.right}</span>
					</div>
				)}

				<span class="panel-sticker panel-sticker--gratis">{badge}</span>
			</>
		)
	}
</div>

<style>
	.practice-shell {
		--panel-accent: var(--blue);
		position: relative;
		padding: 22px 24px 20px;
		border: 1px solid var(--panel-border);
		border-radius: var(--panel-radius) var(--panel-radius) var(--panel-radius) 12px;
		background: var(--panel-bg);
		box-shadow: var(--panel-shadow-blue);
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.35s ease;
	}

	.practice-shell::before {
		content: '';
		position: absolute;
		top: 0;
		left: 28px;
		right: 28px;
		height: 3px;
		border-radius: 0 0 4px 4px;
		background: linear-gradient(90deg, var(--blue), #7aa8ff 58%, rgba(122, 168, 255, 0));
	}

	.practice-shell:hover {
		transform: translateY(-6px) rotate(-0.5deg);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 4px 10px -4px rgba(35, 39, 46, 0.12),
			0 36px 62px -30px rgba(37, 99, 235, 0.5);
	}

	.panel-status {
		margin-bottom: 15px;
	}

	.practice-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}

	.head-text h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.head-text p {
		margin: 5px 0 0;
		font-size: 11px;
		color: #8a8f99;
	}

	.practice-ring {
		position: relative;
		width: 56px;
		height: 56px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
	}

	.practice-ring svg {
		transform: rotate(-90deg);
	}

	.ring-track {
		fill: none;
		stroke: #e9eefb;
		stroke-width: 6;
	}

	.ring-progress {
		fill: none;
		stroke: var(--blue);
		stroke-width: 6;
		stroke-linecap: round;
		stroke-dasharray: var(--c);
		stroke-dashoffset: var(--off);
		transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 0.8, 0.28, 1);
	}

	.ring-label {
		position: absolute;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
	}

	:global(.js) :global(.reveal:not(.is-visible)) .ring-progress {
		stroke-dashoffset: var(--c);
		transition: none;
	}

	.practice-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 16px 0 14px;
	}

	.chip {
		padding: 5px 9px;
		border-radius: 999px;
		background: var(--blue-soft);
		color: var(--blue);
		font-size: 9px;
		font-weight: 700;
	}

	.practice-rec {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 14px;
		padding: 9px 11px;
		border: 1px solid #e3ecfd;
		border-radius: 12px;
		background: linear-gradient(90deg, var(--blue-soft) 0%, rgba(238, 244, 255, 0.2) 100%);
	}

	.rec-icon {
		width: 22px;
		height: 22px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 8px;
		background: #fff;
		color: var(--blue);
		box-shadow: 0 6px 12px -8px rgba(37, 99, 235, 0.9);
	}

	.rec-label {
		flex: 0 0 auto;
		white-space: nowrap;
		font-size: 10px;
		font-weight: 700;
		color: var(--ink);
	}

	.rec-value {
		margin-left: auto;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: 9px;
		color: var(--blue);
	}

	.practice-row {
		display: grid;
		grid-template-columns: 1fr 58px;
		gap: 10px;
		align-items: center;
		padding: 8px 0;
	}

	.practice-label {
		font-size: 10px;
		font-weight: 600;
		color: #3f434a;
	}

	.practice-meta {
		font-family: var(--font-mono);
		font-size: 8px;
		color: #8a8f99;
		text-align: right;
	}

	.practice-bar {
		grid-column: 1 / -1;
		height: 5px;
		border-radius: 999px;
		background: #f1eee8;
		overflow: hidden;
	}

	.practice-bar span {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--blue), #7aa8ff);
		transform: scaleX(var(--v, 0));
		transform-origin: left center;
		transition: transform 0.9s cubic-bezier(0.22, 0.8, 0.28, 1);
		transition-delay: var(--d, 0ms);
	}

	:global(.js) :global(.reveal:not(.is-visible)) .practice-bar span {
		transform: scaleX(0);
		transition: none;
	}

	.practice-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 16px;
		padding-top: 14px;
		border-top: 1px dashed #ece7df;
		font-size: 10px;
		color: #8a8f99;
	}

	.practice-caption {
		margin: 10px 0 0;
		font-family: var(--font-mono);
		font-size: 8px;
		color: #9aa0ab;
	}

	/* --- compact ---------------------------------------------------------- */

	.practice--compact {
		--panel-accent: var(--blue);
	}

	.practice--compact:hover {
		transform: translateY(-4px) rotate(-0.6deg);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 4px 10px -4px rgba(35, 39, 46, 0.12),
			0 30px 50px -28px rgba(37, 99, 235, 0.45);
	}

	.practice--compact .mock-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 10px;
	}

	.practice--compact .practice-chips {
		gap: 5px;
		margin: 0 0 11px;
	}

	.practice--compact .chip {
		padding: 4px 8px;
		font-size: 8px;
	}

	.practice--compact .practice-row {
		padding: 6px 0;
	}

	.practice--compact .practice-bar {
		height: 4px;
	}

	@media (max-width: 640px) {
		.practice-shell {
			padding: 18px 16px 16px;
			border-radius: 24px 24px 24px 10px;
		}

		.practice-shell::before {
			left: 20px;
			right: 20px;
		}

		.head-text h3 {
			font-size: 17px;
		}

		.practice-ring {
			width: 48px;
			height: 48px;
		}

		.practice-ring svg {
			width: 48px;
			height: 48px;
		}

		.ring-label {
			font-size: 11px;
		}

		.practice-rec {
			flex-wrap: wrap;
		}

		.rec-value {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
