---
import {
	DEFAULT_FAQ_LABELS,
	SLIT_PRESETS,
	itemIds,
	pickOnInk,
	queryHint,
	resolveOpen,
	splitLines,
	stripHtml,
	type FaqItem,
	type SlitPaletteInput,
	type SlitPreset,
	type SlitTypeFaqContact,
	type SlitTypeFaqLabels,
} from '../../lib/slit-type-faq';

interface Props {
	items?: FaqItem[];
	/** Display headline. Use "\n" for line breaks. Set in capitals. */
	headline?: string;
	/** Semantic heading level for the section headline ('h1' when used as page hero). */
	headingTag?: 'h1' | 'h2';
	/** How much of each capital the slit hides at rest, 0 to 0.5. Hover lifts clear. */
	slit?: number;
	/** Short intro text next to the search field. */
	intro?: string;
	preset?: SlitPreset;
	/** Override the light palette of the preset. */
	palette?: SlitPaletteInput;
	/** Override the dark palette of the preset. */
	darkPalette?: SlitPaletteInput;
	/** "auto" follows a `.dark` class on any ancestor. */
	theme?: 'auto' | 'light' | 'dark';
	/** "single" closes the open question when another opens. */
	type?: 'single' | 'multiple';
	/** Index or id of the question(s) open on first render. Pass [] for none. */
	defaultOpen?: number | string | (number | string)[];
	/** Prefixed to every question id, so two FAQs on one page never share a #hash. */
	idPrefix?: string;
	/** Show the search field. */
	search?: boolean;
	searchLabel?: string;
	/** Category chips, filtered against `item.category`. Omit to hide the chips. */
	categories?: string[];
	/** Optional line of short phrases that runs between rules under the headline. */
	ticker?: string[];
	/** Closing row. Pass null to drop it. */
	contact?: SlitTypeFaqContact | null;
	/** Show a copy-link button in each open answer. */
	copyLinks?: boolean;
	/** Write the open question's id into location.hash. */
	syncHash?: boolean;
	/** Minimum height of the section. */
	minHeight?: number | string;
	/** Font stacks. */
	displayFont?: string;
	textFont?: string;
	/** UI label overrides for localization. */
	labels?: Partial<SlitTypeFaqLabels>;
	ariaLabel?: string;
	class?: string;
	style?: string;
}

const {
	items = [],
	headline = 'Pertanyaan\nUmum',
	headingTag = 'h2',
	slit = 0.24,
	intro = 'Semua informasi penting seputar akun, pembelian paket, metode pembayaran, dan aturan ujian CBT di Ascendemy.',
	preset = 'ascendemy',
	palette,
	darkPalette,
	theme = 'light',
	type = 'single',
	defaultOpen = 0,
	idPrefix = '',
	search = true,
	searchLabel = 'Cari pertanyaan atau jawaban',
	categories,
	ticker,
	contact = {
		prompt: 'Masih punya pertanyaan?',
		label: 'Email tim Ascendemy',
		href: 'mailto:ascendemyofficial@gmail.com',
	},
	copyLinks = true,
	syncHash = false,
	minHeight = 0,
	displayFont = 'var(--font-display)',
	textFont = 'var(--font-body)',
	labels: labelOverrides,
	ariaLabel,
	class: className = '',
	style: extraStyle = '',
} = Astro.props;

const labels: SlitTypeFaqLabels = { ...DEFAULT_FAQ_LABELS, ...labelOverrides };
const uid = `stf-${crypto.randomUUID().slice(0, 8)}`;
const single = type === 'single';

const ids = itemIds(
	items.map((it) => it.question),
	items.map((it) => it.id),
).map((id) => idPrefix + id);

const initialOpen = resolveOpen(defaultOpen, ids, single, idPrefix);
const answerTexts = items.map((it) => it.answerText ?? stripHtml(it.answerHtml));

const base = SLIT_PRESETS[preset] ?? SLIT_PRESETS.ascendemy;
const light = { ...base.light, ...palette };
const dark = { ...base.dark, ...darkPalette };
const onLight =
	palette?.onInk ??
	(palette?.ink || palette?.paper ? pickOnInk(light.ink, light.paper) : (light.onInk ?? pickOnInk(light.ink, light.paper)));
const onDark =
	darkPalette?.onInk ??
	(darkPalette?.ink || darkPalette?.paper ? pickOnInk(dark.ink, dark.paper) : (dark.onInk ?? pickOnInk(dark.ink, dark.paper)));

const cut = Math.min(0.5, Math.max(0, slit));
const minHeightCss = typeof minHeight === 'number' ? `${minHeight}px` : minHeight;
const rootStyle = [
	`--stf-cut:${cut > 0 ? `calc(${(cut * 0.72).toFixed(3)}em + 0.05em)` : '0px'}`,
	`--stf-paper-l:${light.paper}`,
	`--stf-ink-l:${light.ink}`,
	`--stf-on-l:${onLight}`,
	`--stf-paper-d:${dark.paper}`,
	`--stf-ink-d:${dark.ink}`,
	`--stf-on-d:${onDark}`,
	`--stf-display-font:${displayFont}`,
	`--stf-text-font:${textFont}`,
	`min-height:${minHeightCss}`,
	extraStyle,
]
	.filter(Boolean)
	.join(';');

const lines = headline ? splitLines(headline) : [];
const plainHeadline = lines.join(' ');
const hint = queryHint(items) || 'pembayaran';

const categoryCounts: Record<string, number> = {};
items.forEach((it) => {
	if (it.category) categoryCounts[it.category] = (categoryCounts[it.category] || 0) + 1;
});

let charIndex = 0;
const HeadingTag = headingTag;
const ItemHeadingTag = headingTag === 'h1' ? 'h2' : 'h3';

const clientConfig = {
	single,
	syncHash,
	labels,
	items: items.map((it, i) => ({
		id: ids[i],
		question: it.question,
		answerText: answerTexts[i],
		category: it.category ?? null,
	})),
	initialOpen,
};
---

<section
	class:list={['stf', className]}
	data-stf-root
	data-theme={theme}
	data-intro="pending"
	aria-label={ariaLabel ?? (headline ? undefined : labels.defaultAriaLabel)}
	aria-labelledby={!ariaLabel && headline ? `${uid}-h` : undefined}
	style={rootStyle}
>
	<div class="stf-wrap">
		{
			headline ? (
				<HeadingTag
					class="stf-title"
					id={`${uid}-h`}
					aria-label={plainHeadline}
					data-slit={cut > 0 ? 'true' : 'false'}
				>
					{lines.map((line) => (
						<span class="stf-line" aria-hidden="true">
							{line.split(' ').map((word, wi, words) => (
								<>
									<span class="stf-word">
										{Array.from(word).map((ch) => (
											<span class="stf-ch" style={`--i:${charIndex++}`}>
												{ch}
											</span>
										))}
									</span>
									{wi < words.length - 1 ? ' ' : null}
								</>
							))}
						</span>
					))}
				</HeadingTag>
			) : null
		}

		{
			ticker && ticker.length ? (
				<div class="stf-ticker" data-stf-ticker data-paused="false">
					<p class="stf-sr">{ticker.join('. ')}</p>
					<div class="stf-ticker-mask" aria-hidden="true">
						<div class="stf-ticker-track">
							{[0, 1].map(() => (
								<div class="stf-ticker-run">
									{[...ticker, ...ticker].map((t) => (
										<span>{t}</span>
									))}
								</div>
							))}
						</div>
					</div>
					<button
						type="button"
						class="stf-ticker-toggle"
						data-stf-ticker-toggle
						aria-label={labels.pauseTicker}
						aria-pressed="false"
					>
						<svg class="stf-icon-pause" viewBox="0 0 14 14" aria-hidden="true">
							<path d="M3 2h3v10H3zM8 2h3v10H8z" fill="currentColor" />
						</svg>
						<svg class="stf-icon-play" viewBox="0 0 14 14" aria-hidden="true" hidden>
							<path d="M3.5 2v10l8.5-5z" fill="currentColor" />
						</svg>
					</button>
				</div>
			) : null
		}

		{
			intro || search ? (
				<div class="stf-meta">
					{intro ? <p class="stf-intro">{intro}</p> : <span />}
					{search ? (
						<div class="stf-search" role="search">
							<label for={`${uid}-q`}>{searchLabel}</label>
							<div class="stf-field">
								<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
									<path
										d="m13 13 5 5"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
									/>
								</svg>
								<input
									id={`${uid}-q`}
									data-stf-search
									type="search"
									autocomplete="off"
									spellcheck="false"
									placeholder={`${labels.searchHintPrefix}${hint}”`}
								/>
								<button type="button" class="stf-clear" data-stf-clear hidden>
									{labels.clearSearch}
								</button>
							</div>
							<div class="stf-count" data-stf-count aria-live="polite" />
						</div>
					) : null}
				</div>
			) : null
		}

		{
			categories && categories.length ? (
				<ul class="stf-chips" aria-label={labels.filterAriaLabel}>
					<li>
						<button
							type="button"
							class="stf-chip"
							data-stf-cat-btn=""
							aria-pressed="true"
						>
							{labels.allCategory} <small data-stf-cat-count="">{items.length}</small>
						</button>
					</li>
					{categories.map((c) => (
						<li>
							<button
								type="button"
								class="stf-chip"
								data-stf-cat-btn={c}
								aria-pressed="false"
							>
								{c} <small data-stf-cat-count={c}>{categoryCounts[c] || 0}</small>
							</button>
						</li>
					))}
				</ul>
			) : null
		}

		<ul
			class="stf-list"
			data-stf-list
			aria-label={plainHeadline ? undefined : labels.questionsAriaLabel}
			hidden={items.length === 0}
		>
			{
				items.map((it, i) => {
					const id = ids[i];
					const isOpen = initialOpen.includes(id);
					const btnId = `${uid}-b-${i}`;
					const panelId = `${uid}-p-${i}`;
					const hasBlock = /^\s*<(?:p|ul|ol|div|blockquote)\b/i.test(it.answerHtml);
					const renderedAnswer = hasBlock ? it.answerHtml : `<p>${it.answerHtml}</p>`;

					return (
						<li
							id={id}
							class="stf-item"
							data-stf-item={id}
							data-state={isOpen ? 'open' : 'closed'}
						>
							<span class="stf-fill" aria-hidden="true" />
							<ItemHeadingTag class="stf-h">
								<button
									id={btnId}
									type="button"
									class="stf-btn"
									data-stf-btn={id}
									aria-expanded={isOpen ? 'true' : 'false'}
									aria-controls={panelId}
								>
									{[false, true].map((inv) => (
										<span
											class:list={['stf-row', inv && 'stf-row--inv']}
											aria-hidden={inv ? 'true' : undefined}
										>
											<span class="stf-label">
												<span class="stf-q" data-stf-q>
													{it.question}
												</span>
												<span class="stf-snippet" data-stf-snippet hidden />
											</span>
											<span class="stf-cell" aria-hidden="true">
												<svg class="stf-plus" viewBox="0 0 32 32" fill="none">
													<path
														d="M16 1v30M1 16h30"
														stroke="currentColor"
														stroke-width="2"
													/>
												</svg>
											</span>
										</span>
									))}
								</button>
							</ItemHeadingTag>
							<div
								class="stf-panel"
								id={panelId}
								role="region"
								aria-labelledby={btnId}
							>
								<div class="stf-panel-in">
									<div class="stf-answer">
										<div class="stf-text" data-stf-text set:html={renderedAnswer} />
										{copyLinks || (categories?.length && it.category) ? (
											<div class="stf-tools">
												{categories?.length && it.category ? <span class="stf-tag">{it.category}</span> : null}
												{copyLinks ? (
													<button
														type="button"
														class="stf-copy"
														data-stf-copy={id}
													>
														{labels.copyLink}
													</button>
												) : null}
											</div>
										) : null}
									</div>
								</div>
							</div>
						</li>
					);
				})
			}
		</ul>

		<div class="stf-empty" data-stf-empty role="status" hidden={items.length > 0}>
			<p data-stf-empty-msg />
			<button type="button" class="stf-copy stf-reset" data-stf-reset>
				{labels.resetFilter}
			</button>
		</div>

		{
			contact ? (
				<div class="stf-contact">
					<p>{contact.prompt}</p>
					<a class="stf-cta" href={contact.href}>
						<span>
							{contact.label}
							<svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
								<path
									d="M3 9h11M10 4.5 14.5 9 10 13.5"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						<span aria-hidden="true">
							{contact.label}
							<svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
								<path
									d="M3 9h11M10 4.5 14.5 9 10 13.5"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
					</a>
				</div>
			) : null
		}

		<span class="stf-sr" data-stf-live aria-live="polite" />
	</div>

	<script
		type="application/json"
		data-stf-config
		set:html={JSON.stringify(clientConfig).replace(/</g, '\\u003c')}
	/>
</section>

<script>
	import '../../scripts/slit-type-faq';
</script>

<style>
	.stf {
		--stf-flood-in: 400ms;
		--stf-flood-out: 280ms;
		--stf-rule: 1px;
		--stf-ease-flood: cubic-bezier(0.76, 0, 0.24, 1);
		--stf-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
		--p: var(--stf-paper-l);
		--k: var(--stf-ink-l);
		--o: var(--stf-on-l);
		position: relative;
		container-type: inline-size;
		width: 100%;
		overflow-x: clip;
		box-sizing: border-box;
		background: var(--p);
		color: var(--k);
		font-family: var(--stf-text-font);
		-webkit-font-smoothing: antialiased;
		padding: clamp(52px, 7vw, 104px) 0 clamp(44px, 5.5vw, 84px);
	}

	:global(.dark) .stf[data-theme='auto'],
	.stf[data-theme='dark'] {
		--p: var(--stf-paper-d);
		--k: var(--stf-ink-d);
		--o: var(--stf-on-d);
	}

	.stf *,
	.stf *::before,
	.stf *::after {
		box-sizing: border-box;
	}

	.stf ::selection {
		background: var(--k);
		color: var(--o);
	}

	.stf :focus-visible {
		outline: 2px solid var(--k);
		outline-offset: 3px;
	}

	.stf [hidden] {
		display: none !important;
	}

	.stf-wrap {
		--stf-gutter: max(24px, calc(50cqi - 600px));
		padding: 0 var(--stf-gutter);
	}

	@container (max-width: 640px) {
		.stf-wrap {
			--stf-gutter: 16px;
		}
	}

	.stf-title {
		margin: 0;
		font-family: var(--stf-display-font);
		font-weight: 800;
		font-size: clamp(40px, 12.2cqi, 148px);
		line-height: 0.86;
		letter-spacing: -0.045em;
		text-transform: uppercase;
		color: var(--k);
		--stf-cut-k: 1;
	}

	.stf-title[data-slit='true'] {
		cursor: default;
	}

	@container (max-width: 560px) {
		.stf-title {
			--stf-cut-k: 0.86;
		}
	}

	.stf-line {
		display: block;
		overflow: hidden;
		padding-top: 0.06em;
		margin-top: -0.06em;
	}

	.stf-word {
		display: inline-block;
		white-space: nowrap;
	}

	.stf-ch {
		display: inline-block;
		transform: translateY(calc(var(--stf-cut) * var(--stf-cut-k)));
		transition: transform 820ms var(--stf-ease-out);
		transition-delay: min(calc(var(--i) * 26ms), 420ms);
	}

	:global(.js) .stf[data-intro='pending'] .stf-ch {
		transform: translateY(118%);
		transition: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.stf-title[data-slit='true']:hover .stf-ch {
			transform: translateY(0);
			transition-duration: 420ms;
			transition-delay: min(calc(var(--i) * 14ms), 220ms);
		}
	}

	.stf-ticker {
		margin-top: clamp(28px, 3.4cqi, 48px);
		border-top: var(--stf-rule) solid var(--k);
		border-bottom: var(--stf-rule) solid var(--k);
		overflow: hidden;
		white-space: nowrap;
		font-size: clamp(14px, 1.55cqi, 22px);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		padding: 0.55em 0;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.stf-ticker-mask {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.stf-ticker-toggle {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		appearance: none;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--k);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	.stf-ticker-toggle svg {
		width: 14px;
		height: 14px;
	}

	.stf-ticker[data-paused='false'] .stf-icon-play,
	.stf-ticker[data-paused='true'] .stf-icon-pause {
		display: none;
	}

	.stf-ticker-toggle:hover {
		background: var(--k);
		color: var(--o);
	}

	.stf-ticker-toggle:focus-visible {
		outline: 2px solid var(--k);
		outline-offset: 2px;
	}

	.stf-ticker-track {
		display: inline-flex;
		animation: stf-ticker 38s linear infinite;
	}

	.stf-ticker:hover .stf-ticker-track,
	.stf-ticker:focus-within .stf-ticker-track,
	.stf-ticker[data-paused='true'] .stf-ticker-track {
		animation-play-state: paused;
	}

	.stf-ticker-run {
		display: inline-flex;
		flex: none;
	}

	.stf-ticker-run span {
		padding: 0 0.9em;
	}

	.stf-ticker-run span::after {
		content: '';
		display: inline-block;
		width: 0.36em;
		height: 0.36em;
		border-radius: 50%;
		background: var(--k);
		margin-left: 1.8em;
		vertical-align: 0.14em;
	}

	@keyframes stf-ticker {
		to {
			transform: translateX(-50%);
		}
	}

	.stf-meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 28px;
		margin: clamp(32px, 4.2cqi, 64px) 0 clamp(24px, 3cqi, 40px);
		align-items: end;
	}

	@container (min-width: 760px) {
		.stf-meta {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
			gap: 48px;
		}
	}

	.stf-intro {
		margin: 0;
		max-width: 36ch;
		font-size: clamp(16px, 1.4cqi, 20px);
		line-height: 1.5;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}

	.stf-search {
		position: relative;
	}

	.stf-search label {
		display: block;
		font-family: var(--font-mono, var(--stf-text-font));
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-bottom: 6px;
		opacity: 0.82;
	}

	.stf-field {
		position: relative;
		display: flex;
		align-items: center;
		border-bottom: var(--stf-rule) solid var(--k);
	}

	.stf-field svg {
		flex: none;
		width: 20px;
		height: 20px;
		margin-right: 10px;
	}

	.stf-field input {
		flex: 1;
		min-width: 0;
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--k);
		font: inherit;
		font-size: clamp(17px, 1.55cqi, 21px);
		font-weight: 500;
		padding: 10px 0 12px;
		outline: none;
	}

	.stf-field input::placeholder {
		color: var(--k);
		opacity: 0.5;
	}

	.stf-field input::-webkit-search-cancel-button {
		display: none;
	}

	.stf-field:focus-within {
		box-shadow: 0 1px 0 var(--k);
	}

	.stf-clear {
		flex: none;
		appearance: none;
		border: 0;
		background: none;
		color: var(--k);
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
		padding: 10px 0 10px 12px;
	}

	.stf-count {
		margin-top: 8px;
		font-family: var(--font-mono, var(--stf-text-font));
