---
import Eyebrow from '../ui/Eyebrow.astro';
import PriceCard from './PriceCard.astro';

const plans = [
	{
		name: 'Latihan',
		amount: 'Gratis',
		period: 'Selamanya',
		description:
			'Untuk membangun fondasi matematika dari topik dasar hingga lanjutan.',
		features: [
			'Paket latihan matematika SMP & SMA',
			'Ribuan soal dengan pembahasan',
			'Pantau progres belajar',
			'Tanpa kartu kredit',
		],
		ctaLabel: 'Mulai latihan',
		ctaHref: 'https://cbt.ascendemy.id/latihan',
		ctaVariant: 'ghost' as const,
	},
	{
		name: 'Tryout TKA',
		amount: 'Rp20.000',
		period: 'mulai dari · akses penuh',
		description: 'Untuk mengukur kesiapan menghadapi Tes Kemampuan Akademik.',
		features: [
			'Paket TKA SMP & SMA',
			'2 ujian per paket TKA SMP',
			'Timer dan analisis skor',
			'Pembahasan jawaban',
		],
		ctaLabel: 'Pilih tryout',
		ctaHref: 'https://cbt.ascendemy.id/tryout',
		ctaVariant: 'primary' as const,
		featured: true,
		badge: 'Paling populer',
	},
	{
		name: 'AMO 2026',
		amount: 'Gratis',
		period: 'Khusus siswa SMA/MA/SMK',
		description:
			'Untuk membuktikan kemampuan di olimpiade matematika tingkat nasional.',
		features: [
			'Pendaftaran gratis',
			'100% online',
			'E-sertifikat untuk peserta',
			'Hadiah uang tunai untuk juara umum',
		],
		ctaLabel: 'Daftar AMO',
		ctaHref: 'https://cbt.ascendemy.id/kompetisi',
		ctaVariant: 'ghost' as const,
	},
];
---

<section class="section section--cream" id="harga">
	<div class="container">
		<div class="section-head reveal">
			<Eyebrow>Harga transparan</Eyebrow>
			<h2>Mulai gratis, upgrade saat siap</h2>
			<p>
				Pilih paket sesuai targetmu. Pembayaran diproses melalui channel resmi yang aman.
			</p>
		</div>

		<div class="pricing-grid">
			{plans.map((plan) => <PriceCard {...plan} />)}
		</div>

		<p class="price-note">
			Harga dapat berubah sesuai periode promo. Cek halaman paket untuk harga terbaru.
		</p>
	</div>
</section>

<style>
	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		align-items: stretch;
	}

	.price-note {
		margin: 28px 0 0;
		font-size: 11px;
		text-align: center;
		color: #8a8f99;
	}

	@media (max-width: 900px) {
		.pricing-grid {
			grid-template-columns: 1fr;
			max-width: 520px;
			margin: 0 auto;
		}
	}

	@media (max-width: 640px) {
		.section-head {
			margin-bottom: 32px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
