---
const stats = [
	{ value: 1641, suffix: '', label: 'Paket ujian' },
	{ value: 19975, suffix: '', label: 'Soal tersedia' },
	{ value: 841, suffix: '+', label: 'Siswa bergabung' },
	{ value: 98, suffix: '%', label: 'Tingkat kepuasan' },
];
---

<section class="stats" aria-label="Statistik Ascendemy">
	<div class="container">
		<div class="stats-grid">
			{stats.map((stat) => (
				<div class="stat reveal">
					<strong data-count={stat.value} data-suffix={stat.suffix}>
						{stat.value.toLocaleString('id-ID') + stat.suffix}
					</strong>
					<span>{stat.label}</span>
				</div>
			))}
		</div>
		<p class="stats-note">Data per Oktober 2026, diperbarui langsung dari platform Ascendemy.</p>
	</div>
</section>

<script>
	const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function render(el: HTMLElement, value: number) {
		const target = Number(el.dataset.count);
		const formatted = Math.round(value).toLocaleString('id-ID');
		el.textContent = formatted + (el.dataset.suffix ?? '');
		return target;
	}

	if (counters.length) {
		if (reduceMotion || !('IntersectionObserver' in window)) {
			counters.forEach((el) => render(el, Number(el.dataset.count)));
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						const el = entry.target as HTMLElement;
						const target = Number(el.dataset.count);
						const start = performance.now();
						const duration = 1500;

						function tick(now: number) {
							const progress = Math.min((now - start) / duration, 1);
							const eased = 1 - Math.pow(1 - progress, 3);
							render(el, target * eased);

							if (progress < 1) {
								window.requestAnimationFrame(tick);
							} else {
								el.textContent =
									target.toLocaleString('id-ID') + (el.dataset.suffix ?? '');
							}
						}

						window.requestAnimationFrame(tick);
						observer.unobserve(el);
					});
				},
				{ threshold: 0.4 },
			);

			counters.forEach((el) => observer.observe(el));
		}
	}
</script>

<style>
	.stats {
		padding: 72px 0;
		background: var(--ink);
		color: #fff;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
	}

	.stat {
		padding-left: 24px;
		border-left: 1px solid rgba(255, 255, 255, 0.13);
	}

	.stat:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.stat strong {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(36px, 4.8vw, 56px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.stat span {
		display: block;
		margin-top: 10px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #b9bdc6;
	}

	.stats-note {
		margin-top: 28px;
		font-size: 11px;
		color: #8d929c;
	}

	@media (max-width: 900px) {
		.stats-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 32px 24px;
		}

		.stat:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
	}

	@media (max-width: 640px) {
		.stats {
			padding: 54px 0;
		}

		.stat {
			padding-left: 16px;
		}

		.stat strong {
			font-size: 38px;
		}

		.stat span {
			font-size: 10px;
		}
	}
</style>
