---
const stats = [
	{ key: 'packages', value: 1641, suffix: '', label: 'Paket ujian' },
	{ key: 'questions', value: 19975, suffix: '', label: 'Soal tersedia' },
	{ key: 'students', value: 841, suffix: '+', label: 'Siswa bergabung' },
];
---

<section class="stats" aria-label="Statistik Ascendemy" data-pause-offscreen>
	<div class="polar-layer polar-layer--night" aria-hidden="true">
		<span class="polar-ribbon polar-ribbon--1"></span>
		<span class="polar-ribbon polar-ribbon--2"></span>
		<span class="polar-stars"></span>
	</div>
	<div class="container">
		<div class="stats-grid" data-stagger>
			{stats.map((stat) => (
				<div class="stat reveal">
					<strong data-count={stat.value} data-suffix={stat.suffix} data-stat={stat.key}>
						{stat.value.toLocaleString('id-ID') + stat.suffix}
					</strong>
					<span>{stat.label}</span>
				</div>
			))}
			<div class="stat reveal">
				<strong data-traffic aria-live="polite">—</strong>
				<span>Traffic harian</span>
			</div>
		</div>
		<p class="stats-note">
			Data platform diperbarui otomatis dari CBT App. Traffic harian dihitung dari kunjungan hari ini.
		</p>
	</div>
</section>

<script>
	import { fetchCbt, type ApiResponse, type CbtStats } from '../../lib/cbt-api';

	const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function render(el: HTMLElement, value: number) {
		const target = Number(el.dataset.count);
		const formatted = Math.round(value).toLocaleString('id-ID');
		el.textContent = formatted + (el.dataset.suffix ?? '');
		return target;
	}

	if (counters.length) {
		if (reduceMotion || !('IntersectionObserver' in window)) {
			counters.forEach((el) => render(el, Number(el.dataset.count)));
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						const el = entry.target as HTMLElement;
						const target = Number(el.dataset.count);
						const start = performance.now();
						const duration = 1500;

						function tick(now: number) {
							const progress = Math.min((now - start) / duration, 1);
							const eased = 1 - Math.pow(1 - progress, 3);
							render(el, target * eased);

							if (progress < 1) {
								window.requestAnimationFrame(tick);
							} else {
								el.textContent =
									target.toLocaleString('id-ID') + (el.dataset.suffix ?? '');
							}
						}

						window.requestAnimationFrame(tick);
						observer.unobserve(el);
					});
				},
				{ threshold: 0.4 },
			);

			counters.forEach((el) => observer.observe(el));
		}
	}

	const trafficEl = document.querySelector<HTMLElement>('[data-traffic]');

	type StatsPayload = ApiResponse<CbtStats>;

	const applyStats = (stats: CbtStats) => {
		const values = {
			packages: stats.packages,
			questions: stats.questions,
			students: stats.students,
		};

		Object.entries(values).forEach(([key, value]) => {
			const el = document.querySelector<HTMLElement>(`[data-stat="${key}"]`);
			if (!el) return;

			el.dataset.count = String(value);
			el.textContent = value.toLocaleString('id-ID') + (el.dataset.suffix ?? '');
		});

		if (trafficEl) {
			trafficEl.textContent = stats.traffic_today.toLocaleString('id-ID');
		}
	};

	const loadStats = async () => {
		try {
			const response = await fetchCbt<StatsPayload>('landing/visit', { method: 'POST' });
			applyStats(response.data);
		} catch {
			try {
				const response = await fetchCbt<StatsPayload>('landing/stats');
				applyStats(response.data);
			} catch {
				if (trafficEl) trafficEl.textContent = '—';
			}
		}
	};

	void loadStats();
</script>

<style>
	.stats {
		position: relative;
		isolation: isolate;
		padding: 72px 0;
		background: var(--ink);
		color: #fff;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			inset 0 70px 70px -70px rgba(255, 255, 255, 0.1);
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
	}

	.stat {
		padding-left: 24px;
		border-left: 1px solid rgba(255, 255, 255, 0.13);
	}

	.stat:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.stat strong {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(36px, 4.8vw, 56px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.stat span {
		display: block;
		margin-top: 10px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #b9bdc6;
	}

	.stats-note {
		margin-top: 28px;
		font-size: 11px;
		color: #8d929c;
	}

	@media (max-width: 900px) {
		.stats-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 32px 24px;
		}

		.stat:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
	}

	@media (max-width: 640px) {
		.stats {
			padding: 54px 0;
		}

		.stat {
			padding-left: 16px;
		}

		.stat strong {
			font-size: 38px;
		}

		.stat span {
			font-size: 10px;
		}
	}
</style>
