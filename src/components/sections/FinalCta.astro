---
import Button from '../ui/Button.astro';
import HighlightText from '../ui/HighlightText.astro';
import Icon from '../ui/Icon.astro';
import MathScramble from '../ui/MathScramble.astro';

const trust = [
	'Latihan dasar gratis selamanya',
	'19.975 soal + pembahasan lengkap',
	'Tanpa kartu kredit',
];
---

<section class="cta" data-pause-offscreen>
	<div class="polar-layer polar-layer--frost" aria-hidden="true"></div>
	<MathScramble count={20} blueRatio={0.35} seed={21} safe={{ x1: 22, x2: 78, y1: 8, y2: 94 }} />
	<div class="container cta-inner">
		<h2 class="reveal">Siap naik level bersama Ascendemy?</h2>
		<p class="reveal">
			Bergabung dengan ribuan siswa yang sudah belajar lebih terarah. Mulai dari{' '}
			<HighlightText variant="orange">latihan gratis</HighlightText>, lalu pilih tryout saat kamu siap.
		</p>

		<ul class="cta-trust reveal reveal-list">
			{trust.map((item) => (
				<li>
					<span class="cta-trust-icon">
						<Icon name="check" size={11} />
					</span>
					{item}
				</li>
			))}
		</ul>

		<div class="cta-actions reveal">
			<Button href="https://cbt.ascendemy.id/register" size="lg" icon="arrow">
				Daftar gratis
			</Button>
			<Button href="#harga" variant="ghost" size="lg">Lihat semua paket</Button>
		</div>
	</div>
</section>

<style>
	.cta {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 88px 0;
		background: var(--cream);
		border-top: 1px solid var(--line-warm);
	}

	.cta::before,
	.cta::after {
		content: "";
		position: absolute;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.55;
		pointer-events: none;
	}

	.cta::before {
		width: 360px;
		height: 360px;
		left: -80px;
		top: -120px;
		background: #ffe0c4;
	}

	.cta::after {
		width: 320px;
		height: 320px;
		right: -60px;
		bottom: -120px;
		background: #dbe8ff;
	}

	.cta-inner {
		position: relative;
		z-index: 1;
		max-width: 820px;
		margin: 0 auto;
		text-align: center;
	}

	.cta h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(38px, 5vw, 60px);
		line-height: 1.04;
		letter-spacing: -0.045em;
		color: var(--ink);
	}

	.cta p {
		max-width: 560px;
		margin: 18px auto 0;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.cta-trust {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px 26px;
		flex-wrap: wrap;
		margin: 26px 0 0;
		padding: 0;
		list-style: none;
	}

	.cta-trust li {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-size: 13px;
		font-weight: 600;
		color: #4d535e;
	}

	.cta-trust-icon {
		width: 20px;
		height: 20px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--orange-soft);
		color: var(--orange-deep);
	}

	.cta-trust-icon :global(svg) {
		width: 11px;
		height: 11px;
	}

	.cta-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
		flex-wrap: wrap;
	}

	@media (max-width: 640px) {
		.cta {
			padding: 64px 0;
		}

		.cta-trust {
			gap: 10px 18px;
		}

		.cta-trust li {
			font-size: 12px;
		}

		.cta-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.cta-actions :global(.btn) {
			width: 100%;
		}
	}
</style>
