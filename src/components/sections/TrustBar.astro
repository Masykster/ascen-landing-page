---
import { Image } from 'astro:assets';
import unesa from '../../assets/images/unesa-trim.png';
import pibt from '../../assets/images/pibt-trim.png';
import datanusa from '../../assets/images/datanusa-trim.png';

const partners = [
	{ src: unesa, alt: 'Universitas Negeri Surabaya', width: 163, height: 191 },
	{ src: pibt, alt: 'PIBT Unesa', width: 165, height: 139 },
	{ src: datanusa, alt: 'Inkubator Bisnis Datanusa', width: 196, height: 63 },
];
---

<section class="trust" aria-label="Mitra Ascendemy">
	<div class="container trust-inner">
		<span class="trust-label">Didukung oleh</span>
		<div class="trust-logos">
			{partners.map((partner) => (
				<Image
					src={partner.src}
					alt={partner.alt}
					width={partner.width}
					height={partner.height}
					format="webp"
				/>
			))}
		</div>
	</div>
</section>

<style>
	.trust {
		padding: 26px 0;
		background: #fff;
		border-top: 1px solid var(--line-warm);
		border-bottom: 1px solid var(--line-warm);
	}

	.trust-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 34px;
		flex-wrap: wrap;
	}

	.trust-label {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #a39c93;
	}

	.trust-logos {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 32px;
		flex-wrap: wrap;
	}

	.trust-logos :global(img) {
		height: 38px;
		width: auto;
		opacity: 0.7;
		filter: grayscale(1);
		transition: opacity 0.2s ease, filter 0.2s ease;
	}

	.trust-logos :global(img:hover) {
		opacity: 1;
		filter: none;
	}

	@media (max-width: 640px) {
		.trust-inner {
			gap: 18px;
		}

		.trust-logos {
			gap: 22px;
		}

		.trust-logos :global(img) {
			height: 32px;
		}
	}
</style>
