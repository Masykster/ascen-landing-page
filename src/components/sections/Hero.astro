---
import Button from '../ui/Button.astro';
import ExamSimulator from '../ui/ExamSimulator.astro';
import MathScramble from '../ui/MathScramble.astro';
---

<section class="hero" id="beranda">
	<div class="hero-aurora" aria-hidden="true">
		<span class="aurora aurora--1"></span>
		<span class="aurora aurora--2"></span>
		<span class="aurora aurora--3"></span>
	</div>
	<div class="hero-snow" aria-hidden="true"></div>
	<!-- area tengah (judul + jendela simulator) dikosongkan agar konten tetap terbaca -->
	<MathScramble count={28} blueRatio={0.65} seed={7} safe={{ x1: 17, x2: 83, y1: 9, y2: 100 }} />
	<div class="container">
		<div class="hero-copy">
			<h1>
				Tingkatkan kompetensi dengan <span class="accent">Computer Based Test</span>
			</h1>
			<p class="hero-lede">
				Latihan soal, tryout TKA, dan olimpiade matematika dalam satu platform. Ukur
				kemampuanmu, raih prestasi, dan naik level bersama Ascendemy.
			</p>
			<div class="hero-actions">
				<Button href="https://cbt.ascendemy.id/register" size="lg" icon="arrow">
					Daftar sekarang
				</Button>
				<Button href="#tryout" variant="ghost" size="lg">Jelajahi tryout</Button>
			</div>
			<p class="hero-note">Gratis untuk mulai · 1.641 paket ujian · 19.975 soal</p>
		</div>

		<div class="hero-stage">
			<div class="hero-window">
				<div class="window-bar">
					<div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
					<span class="window-url">cbt.ascendemy.id</span>
					<span class="window-live">Online</span>
				</div>

				<div class="hero-stage-area">
					<ExamSimulator />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		/* tarik hero ke belakang header agar gradasinya menyatu dengan navbar */
		margin-top: -68px;
		padding: 136px 0 0;
		background:
			/* matahari kutub — sedikit kuning hangat di kiri-atas */
			radial-gradient(760px 380px at 16% -4%, #fff2c8 0%, rgba(255, 242, 200, 0) 68%),
			/* cahaya kutub — biru dingin di kanan-atas */
			radial-gradient(900px 460px at 88% 4%, #d8e9ff 0%, rgba(216, 233, 255, 0) 70%),
			/* dasar es: biru muda → putih, menyatu ke section bawah */
			linear-gradient(180deg, #e9f3ff 0%, #f4faff 52%, #fdfdfd 100%);
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(#cfe0f5 1px, transparent 1px);
		background-size: 26px 26px;
		opacity: 0.5;
		mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
		pointer-events: none;
	}

	/* --- aurora kutub ----------------------------------------------------- */

	.hero-aurora {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.aurora {
		position: absolute;
		left: -12%;
		width: 124%;
		rotate: var(--tilt, 0deg);
		border-radius: 50%;
		filter: blur(38px);
		animation: aurora-drift 16s ease-in-out infinite alternate;
		will-change: translate, opacity;
	}

	.aurora--1 {
		--tilt: -5deg;
		--o-in: 0.5;
		--o-out: 0.68;
		top: 34px;
		height: 150px;
		background: linear-gradient(
			90deg,
			transparent 4%,
			rgba(37, 99, 235, 0.44) 30%,
			rgba(56, 189, 248, 0.48) 55%,
			rgba(255, 224, 132, 0.58) 76%,
			transparent 96%
		);
	}

	.aurora--2 {
		--tilt: 4deg;
		--o-in: 0.38;
		--o-out: 0.54;
		top: 158px;
		height: 190px;
		animation-duration: 21s;
		animation-delay: -7s;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(96, 165, 250, 0.38) 25%,
			rgba(45, 212, 191, 0.34) 58%,
			rgba(255, 214, 110, 0.48) 82%,
			transparent 100%
		);
	}

	.aurora--3 {
		--tilt: -9deg;
		--o-in: 0.5;
		--o-out: 0.66;
		top: -56px;
		height: 120px;
		animation-duration: 13s;
		animation-delay: -3s;
		background: linear-gradient(
			90deg,
			transparent 10%,
			rgba(147, 197, 253, 0.55) 40%,
			rgba(255, 232, 154, 0.62) 70%,
			transparent 92%
		);
	}

	@keyframes aurora-drift {
		from {
			translate: -2.5% -6px;
			opacity: var(--o-in, 0.35);
		}

		to {
			translate: 2.5% 8px;
			opacity: var(--o-out, 0.5);
		}
	}

	/* --- bulir salju turun (murni CSS) ------------------------------------ */

	.hero-snow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(
				circle 4px at 50% 50%,
				rgba(255, 255, 255, 1) 0%,
				rgba(255, 255, 255, 0) 70%
			),
			radial-gradient(
				circle 3px at 50% 50%,
				rgba(168, 207, 255, 1) 0%,
				rgba(168, 207, 255, 0) 70%
			),
			radial-gradient(
				circle 2.5px at 50% 50%,
				rgba(255, 255, 255, 0.95) 0%,
				rgba(255, 255, 255, 0) 70%
			);
		background-size: 96px 150px, 148px 220px, 84px 126px;
		background-position: 18px 0, 60px 0, 6px 0;
		animation: snow-fall 12s linear infinite;
		mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 62%, transparent 96%);
		-webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 62%, transparent 96%);
		will-change: background-position;
	}

	@keyframes snow-fall {
		/* offset y = tinggi tile → loop mulus tanpa lompatan */
		to {
			background-position: 18px 150px, 60px 220px, 6px 126px;
		}
	}

	.hero-copy {
		position: relative;
		max-width: 920px;
		margin: 0 auto;
		text-align: center;
	}

	.hero h1 {
		margin: 22px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(44px, 6.1vw, 74px);
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--ink);
	}

	.hero h1 .accent {
		display: inline-block;
		background: linear-gradient(92deg, var(--blue) 0%, #4f7df0 38%, var(--orange) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-lede {
		max-width: 650px;
		margin: 22px auto 0;
		font-size: 18px;
		line-height: 1.6;
		color: var(--muted);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
		flex-wrap: wrap;
	}

	.hero-note {
		margin-top: 16px;
		font-size: 12px;
		font-weight: 600;
		color: #8a8f99;
		letter-spacing: 0.01em;
	}

	.hero-stage {
		position: relative;
		max-width: 900px;
		margin: 54px auto 0;
		padding-bottom: 86px;
		animation: hero-float 7s ease-in-out infinite alternate;
	}

	@keyframes hero-float {
		from {
			translate: 0 -4px;
		}

		to {
			translate: 0 4px;
		}
	}

	.hero-window {
		position: relative;
		z-index: 2;
		overflow: hidden;
		border: 1px solid #e5ded4;
		border-radius: 28px;
		background: #fff;
		box-shadow: 0 48px 100px -52px rgba(35, 39, 46, 0.55);
	}

	.window-bar {
		height: 44px;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 0 16px;
		background: #fbf7f2;
		border-bottom: 1px solid #eee7de;
	}

	.window-dots {
		display: flex;
		gap: 5px;
	}

	.window-dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #e3d8cb;
	}

	.window-dots span:nth-child(1) {
		background: #f6b39a;
	}

	.window-dots span:nth-child(2) {
		background: #f5d49b;
	}

	.window-dots span:nth-child(3) {
		background: #b9d9b8;
	}

	.window-url {
		flex: 1;
		max-width: 360px;
		margin: 0 auto;
		padding: 5px 12px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #eee7de;
		color: #9a938a;
		font-family: var(--font-mono);
		font-size: 10px;
		text-align: center;
	}

	.window-live {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 10px;
		font-weight: 700;
		color: #2f6b3a;
	}

	.window-live::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #46a758;
	}

	.hero-stage-area {
		position: relative;
		aspect-ratio: 3 / 2;
		background: #f6f2ec;
	}

	@media (max-width: 1080px) {
		.hero h1 {
			font-size: clamp(42px, 6vw, 64px);
		}
	}

	@media (max-width: 900px) {
		.hero {
			padding-top: 122px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			margin-top: -62px;
			padding-top: 104px;
		}

		.hero h1 {
			margin-top: 18px;
			font-size: clamp(38px, 10vw, 48px);
		}

		.hero-lede {
			font-size: 15px;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.hero-actions :global(.btn) {
			width: 100%;
		}

		.hero-stage {
			margin-top: 34px;
			padding-bottom: 46px;
		}

		.hero-window {
			border-radius: 18px;
		}

		.window-bar {
			height: 36px;
			padding: 0 10px;
		}

		.window-url {
			max-width: 190px;
			font-size: 8px;
		}

		.window-live {
			font-size: 8px;
		}

		.hero-stage-area {
			aspect-ratio: 4 / 3;
		}
	}
</style>
