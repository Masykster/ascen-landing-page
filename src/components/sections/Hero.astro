---
import Button from '../ui/Button.astro';
import ExamSimulator from '../ui/ExamSimulator.astro';
import Eyebrow from '../ui/Eyebrow.astro';
---

<section class="hero" id="beranda">
	<div class="container">
		<div class="hero-copy">
			<Eyebrow>Belajar · Tryout · Berkompetisi</Eyebrow>
			<h1>
				Tingkatkan kompetensi dengan <span class="accent">Computer Based Test</span>
			</h1>
			<p class="hero-lede">
				Latihan soal, tryout TKA, dan olimpiade matematika dalam satu platform. Ukur
				kemampuanmu, raih prestasi, dan naik level bersama Ascendemy.
			</p>
			<div class="hero-actions">
				<Button href="https://cbt.ascendemy.id/register" size="lg" icon="arrow">
					Daftar sekarang
				</Button>
				<Button href="#tryout" variant="ghost" size="lg">Jelajahi tryout</Button>
			</div>
			<p class="hero-note">Gratis untuk mulai · 1.641 paket ujian · 19.975 soal</p>
		</div>

		<div class="hero-stage">
			<div class="hero-window">
				<div class="window-bar">
					<div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
					<span class="window-url">cbt.ascendemy.id</span>
					<span class="window-live">Online</span>
				</div>

				<div class="hero-stage-area">
					<ExamSimulator />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: 68px 0 0;
		background:
			radial-gradient(900px 420px at 18% 0%, #fff1e4 0%, rgba(255, 241, 228, 0) 70%),
			radial-gradient(800px 420px at 86% 8%, #eef4ff 0%, rgba(238, 244, 255, 0) 68%),
			linear-gradient(180deg, #fdf9f4 0%, #fdfdfd 78%);
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(#e7ded2 1px, transparent 1px);
		background-size: 26px 26px;
		opacity: 0.45;
		mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
		pointer-events: none;
	}

	.hero-copy {
		position: relative;
		max-width: 920px;
		margin: 0 auto;
		text-align: center;
	}

	.hero h1 {
		margin: 22px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(44px, 6.1vw, 74px);
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--ink);
	}

	.hero h1 .accent {
		display: inline-block;
		background: linear-gradient(92deg, var(--blue) 0%, #4f7df0 38%, var(--orange) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-lede {
		max-width: 650px;
		margin: 22px auto 0;
		font-size: 18px;
		line-height: 1.6;
		color: var(--muted);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
		flex-wrap: wrap;
	}

	.hero-note {
		margin-top: 16px;
		font-size: 12px;
		font-weight: 600;
		color: #8a8f99;
		letter-spacing: 0.01em;
	}

	.hero-stage {
		position: relative;
		max-width: 900px;
		margin: 54px auto 0;
		padding-bottom: 86px;
		animation: hero-float 7s ease-in-out infinite alternate;
	}

	@keyframes hero-float {
		from {
			translate: 0 -4px;
		}

		to {
			translate: 0 4px;
		}
	}

	.hero-window {
		position: relative;
		z-index: 2;
		overflow: hidden;
		border: 1px solid #e5ded4;
		border-radius: 28px;
		background: #fff;
		box-shadow: 0 48px 100px -52px rgba(35, 39, 46, 0.55);
	}

	.window-bar {
		height: 44px;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 0 16px;
		background: #fbf7f2;
		border-bottom: 1px solid #eee7de;
	}

	.window-dots {
		display: flex;
		gap: 5px;
	}

	.window-dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #e3d8cb;
	}

	.window-dots span:nth-child(1) {
		background: #f6b39a;
	}

	.window-dots span:nth-child(2) {
		background: #f5d49b;
	}

	.window-dots span:nth-child(3) {
		background: #b9d9b8;
	}

	.window-url {
		flex: 1;
		max-width: 360px;
		margin: 0 auto;
		padding: 5px 12px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #eee7de;
		color: #9a938a;
		font-family: var(--font-mono);
		font-size: 10px;
		text-align: center;
	}

	.window-live {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 10px;
		font-weight: 700;
		color: #2f6b3a;
	}

	.window-live::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #46a758;
	}

	.hero-stage-area {
		position: relative;
		aspect-ratio: 3 / 2;
		background: #f6f2ec;
	}

	@media (max-width: 1080px) {
		.hero h1 {
			font-size: clamp(42px, 6vw, 64px);
		}
	}

	@media (max-width: 900px) {
		.hero {
			padding-top: 54px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 42px;
		}

		.hero h1 {
			margin-top: 18px;
			font-size: clamp(38px, 10vw, 48px);
		}

		.hero-lede {
			font-size: 15px;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.hero-actions :global(.btn) {
			width: 100%;
		}

		.hero-stage {
			margin-top: 34px;
			padding-bottom: 46px;
		}

		.hero-window {
			border-radius: 18px;
		}

		.window-bar {
			height: 36px;
			padding: 0 10px;
		}

		.window-url {
			max-width: 190px;
			font-size: 8px;
		}

		.window-live {
			font-size: 8px;
		}

		.hero-stage-area {
			aspect-ratio: 4 / 3;
		}
	}
</style>
