---
import Button from '../ui/Button.astro';
import CheckList from '../ui/CheckList.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import PracticePanel from '../ui/PracticePanel.astro';
import SplitLayout from '../ui/SplitLayout.astro';

const benefits = [
	'Soal matematika dari SMP hingga SMA',
	'Pembahasan langkah demi langkah',
	'Pantau progres per topik',
	'Mulai gratis, tanpa kartu kredit',
];
---

<section class="section" id="latihan">
	<SplitLayout>
		<PracticePanel
			slot="media"
			title="Latihan Matematika"
			subtitle="SMA Kelas 12 · 84 paket · 840 soal"
			badge="Gratis"
			chips={['Aljabar', 'Geometri', 'Statistika', 'Peluang']}
			rows={[
				{ label: 'Persamaan linear', value: 84 },
				{ label: 'Fungsi kuadrat', value: 72 },
				{ label: 'Peluang', value: 61 },
				{ label: 'Statistika', value: 48 },
			]}
			footer={{ left: 'Progres belajar 72%', right: '12 soal dikerjakan hari ini' }}
		/>

		<Eyebrow tone="blue">Latihan</Eyebrow>
		<h2>Latihan yang menyesuaikan levelmu</h2>
		<p>
			Mulai dari topik yang paling sering keluar. Setiap jawaban dilengkapi pembahasan agar kamu
			memahami konsepnya, bukan sekadar menghafal rumus.
		</p>
		<CheckList items={benefits} tone="blue" />
		<Button href="https://cbt.ascendemy.id/latihan" icon="arrow">Mulai latihan gratis</Button>
	</SplitLayout>
</section>
