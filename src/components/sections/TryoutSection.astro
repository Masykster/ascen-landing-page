---
import Button from '../ui/Button.astro';
import CheckList from '../ui/CheckList.astro';
import ExamPanel from '../ui/ExamPanel.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SplitLayout from '../ui/SplitLayout.astro';

const benefits = [
	'Timer dan navigasi soal seperti CBT asli',
	'Analisis skor per mata pelajaran',
	'Pembahasan jawaban setelah ujian',
	'Paket TKA SMP mulai Rp20.000',
];
---

<section class="section section--soft" id="tryout">
	<SplitLayout reverse>
		<div slot="media" class="panel-stage panel-stage--orange">
			<ExamPanel
				title="Tryout TKA · Matematika"
				subtitle="2 ujian · akses penuh"
				timer="00:42:18"
				question="Jika 2x + 5 = 17, nilai x adalah…"
				options={['A. 4', 'B. 5', 'C. 6', 'D. 7']}
				correctIndex={2}
				progress={45}
				currentQuestion={9}
				totalQuestions={20}
				footer={{ left: 'Sisa 11 soal · 42 menit', right: 'Skor sementara 78' }}
			/>
		</div>

		<Eyebrow class="reveal">Tryout</Eyebrow>
		<h2 class="reveal">Rasakan ujian sesungguhnya, sebelum hari-H</h2>
		<p class="reveal">
			Tryout TKA dan UTBK dengan antarmuka Computer Based Test, timer, dan analisis hasil. Ketahui
			posisimu lebih awal, lalu perbaiki dengan latihan yang tepat.
		</p>
		<CheckList class="reveal reveal-list" items={benefits} />
		<Button class="reveal" href="https://cbt.ascendemy.id/tryout" icon="arrow">Mulai tryout</Button>
	</SplitLayout>
</section>
