---
import { Image } from 'astro:assets';
import competitionImage from '../../assets/images/Carousel-Kompetisi.webp';
import Button from '../ui/Button.astro';
import CheckList from '../ui/CheckList.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import SplitLayout from '../ui/SplitLayout.astro';

const benefits = [
	'AMO 2026 terbuka gratis untuk siswa SMA/MA/SMK',
	'Dikerjakan 100% online dengan pengawasan',
	'E-sertifikat untuk seluruh peserta',
	'Hadiah uang tunai untuk juara umum',
];
---

<section class="section" id="kompetisi">
	<SplitLayout>
		<Fragment slot="media">
			<div class="media-frame">
				<Image
					src={competitionImage}
					alt="Ascendemy Mathematics Olympiad 2026"
					widths={[640, 1000, 1536]}
					sizes="(max-width: 900px) calc(100vw - 32px), 570px"
					loading="lazy"
				/>
			</div>
			<div class="media-badge">
				<span class="badge-icon"><Icon name="trophy" size={15} /></span>
				<div>
					<strong>Gratis untuk siswa SMA</strong>
					<span>AMO 2026 · 100% online</span>
				</div>
			</div>
		</Fragment>

		<Eyebrow tone="blue">Kompetisi</Eyebrow>
		<h2>Dominasi kompetisi, bangun portofolio untuk kampus impian</h2>
		<p>
			Olimpiade matematika bukan sekadar ajang juara. Sertifikat dan kemampuan pemecahan masalah
			tingkat tinggi membantumu bersaing di jalur prestasi.
		</p>
		<CheckList items={benefits} tone="blue" />
		<div class="competition-actions">
			<Button href="https://cbt.ascendemy.id/kompetisi" icon="arrow">Daftar AMO 2026</Button>
			<Button variant="ghost" href="https://cbt.ascendemy.id/kompetisi">
				Lihat semua kompetisi
			</Button>
		</div>
	</SplitLayout>
</section>

<style>
	.media-frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line-warm);
		border-radius: 28px;
		background: #fff;
		box-shadow: var(--shadow);
	}

	.media-frame :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.media-badge {
		position: absolute;
		right: 16px;
		bottom: 16px;
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 10px 13px;
		border: 1px solid #ece5dc;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 18px 36px -24px rgba(35, 39, 46, 0.45);
		backdrop-filter: blur(8px);
	}

	.media-badge strong {
		display: block;
		font-size: 11px;
		color: var(--ink);
	}

	.media-badge span {
		display: block;
		margin-top: 2px;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--orange-deep);
	}

	.media-badge .badge-icon {
		width: 30px;
		height: 30px;
		border-radius: 9px;
		display: grid;
		place-items: center;
		background: var(--orange-soft);
		color: var(--orange-deep);
	}

	.media-badge :global(svg) {
		width: 15px;
		height: 15px;
	}

	.competition-actions {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	@media (max-width: 640px) {
		.media-frame {
			border-radius: 20px;
		}
	}
</style>
