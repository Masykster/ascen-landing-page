---
import Icon from '../ui/Icon.astro';
import type { Testimonial } from '../../data/testimonials';

interface Props {
	testimonial: Testimonial;
}

const { testimonial } = Astro.props;

const initials = testimonial.name
	.split(' ')
	.slice(0, 2)
	.map((word) => word.charAt(0))
	.join('')
	.toUpperCase();

const toneMap = {
	Latihan: 'blue',
	'Tryout TKA': 'orange',
	'AMO 2026': 'green',
} as const;

const tone = toneMap[testimonial.program];
const gain = testimonial.after - testimonial.before;
---

<article class="review">
	<header class="review-head">
		<span class:list={['review-avatar', `review-avatar--${tone}`]} aria-hidden="true">
			{initials}
		</span>
		<div class="review-id">
			<strong>{testimonial.name}</strong>
			<span>{testimonial.school} · {testimonial.city}</span>
		</div>
	</header>

	<p class="review-quote">&ldquo;{testimonial.quote}&rdquo;</p>

	<footer class="review-result">
		<span class="review-score">
			<span class="review-before">{testimonial.before}</span>
			<Icon name="arrow" size={12} />
			<span class="review-after">{testimonial.after}</span>
		</span>
		<span class="review-metric">{testimonial.metric}</span>
		<span class="review-gain">+{gain}</span>
	</footer>
</article>

<style>
	.review {
		position: relative;
		padding: 18px 20px;
		border: 1px solid var(--line-warm);
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 16px 34px -30px rgba(35, 39, 46, 0.45);
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.review:hover {
		border-color: #eadfce;
		box-shadow: 0 22px 44px -30px rgba(35, 39, 46, 0.5);
	}

	.review-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.review-avatar {
		width: 38px;
		height: 38px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(140deg, #fb923c, var(--orange-deep));
		color: #fff;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.02em;
		box-shadow: 0 10px 18px -12px rgba(249, 115, 22, 0.9);
	}

	.review-avatar--blue {
		background: linear-gradient(140deg, #60a5fa, #1d4ed8);
		box-shadow: 0 10px 18px -12px rgba(37, 99, 235, 0.9);
	}

	.review-avatar--green {
		background: linear-gradient(140deg, #6cc47c, #2f8f45);
		box-shadow: 0 10px 18px -12px rgba(47, 143, 69, 0.9);
	}

	.review-id {
		min-width: 0;
		flex: 1;
	}

	.review-id strong {
		display: block;
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
	}

	.review-id span {
		display: block;
		margin-top: 2px;
		font-family: var(--font-mono);
		font-size: 9.5px;
		color: #9aa0ab;
	}

	.review-quote {
		margin: 14px 0 0;
		font-size: 13px;
		line-height: 1.62;
		color: #4d535e;
	}

	.review-result {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 14px;
		padding-top: 12px;
		border-top: 1px dashed #f0e9df;
	}

	.review-score {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
	}

	.review-score :global(svg) {
		width: 12px;
		height: 12px;
		color: #b9a893;
	}

	.review-before {
		color: #b0b6c0;
	}

	.review-after {
		color: #2f8f45;
	}

	.review-metric {
		font-size: 10px;
		color: #9aa0ab;
	}

	.review-gain {
		margin-left: auto;
		padding: 3px 8px;
		border-radius: 999px;
		background: var(--green-soft);
		color: #2f6b3a;
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 700;
	}
</style>
