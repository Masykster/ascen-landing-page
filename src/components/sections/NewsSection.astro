---
import { featuredNews, newsItems } from '../../data/news';
import Button from '../ui/Button.astro';
import NewsFeaturedCard from './NewsFeaturedCard.astro';
import NewsListItem from './NewsListItem.astro';
---

<section class="section section--cream" id="blog">
	<div class="container">
		<div class="section-head section-head--split">
			<div>
				<h2 class="reveal">Artikel terbaru dari dunia pendidikan</h2>
				<p class="reveal">
					Artikel seputar TKA, olimpiade, dan tips belajar untuk membantumu mengambil keputusan
					yang tepat.
				</p>
			</div>
			<Button class="reveal" variant="ghost" href="/blog" icon="arrow">
				Semua artikel
			</Button>
		</div>

		<div class="news-grid">
			<NewsFeaturedCard {...featuredNews} />

			<div class="news-list reveal reveal-list">
				{newsItems.map((item) => <NewsListItem {...item} />)}
			</div>
		</div>
	</div>
</section>

<style>
	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.section-head--split {
		max-width: none;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 38px;
		text-align: left;
	}

	.section-head--split > div {
		max-width: 640px;
	}

	.section-head--split h2 {
		margin-bottom: 0;
	}

	.section-head--split p {
		margin-left: 0;
	}

	.news-grid {
		display: grid;
		grid-template-columns: 1.08fr 0.92fr;
		gap: 26px;
		align-items: start;
	}

	.news-list {
		overflow: hidden;
		border: 1px solid var(--line-warm);
		border-radius: var(--radius);
		background: #fff;
	}

	@media (max-width: 900px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.section-head {
			margin-bottom: 32px;
		}

		.section-head--split {
			display: block;
		}

		.section-head--split :global(.btn) {
			margin-top: 18px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
