---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Props {
	href: string;
	image: ImageMetadata;
	alt: string;
	date: string;
	category: string;
	title: string;
	excerpt?: string;
	pinned?: boolean;
}

const { href, image, alt, date, category, title, excerpt, pinned = false } = Astro.props;
---

<a class="news-featured reveal reveal-card" href={href}>
	<div class="news-media">
		<Image
			src={image}
			alt={alt}
			widths={[640, 960, 1280]}
			sizes="(max-width: 900px) calc(100vw - 32px), 620px"
		/>
		{pinned && (
			<span class="news-pin"><Icon name="pin" size={10} />Pinned</span>
		)}
	</div>
	<div class="news-body">
		<div class="news-meta">
			<span>{date}</span>
			<span class="sep"></span>
			<span>{category}</span>
		</div>
		<h3>{title}</h3>
		{excerpt && <p>{excerpt}</p>}
		<span class="news-more">Baca selengkapnya <Icon name="arrow" size={16} /></span>
	</div>
</a>

<style>
	.news-featured {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--line-warm);
		border-radius: var(--radius);
		background: #fff;
		transition: box-shadow 0.25s ease, transform 0.25s ease;
	}

	.news-featured:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.news-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: #f3eee8;
	}

	.news-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.news-featured:hover .news-media :global(img) {
		transform: scale(1.03);
	}

	.news-pin {
		position: absolute;
		top: 14px;
		left: 14px;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 9px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		color: #b45309;
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		backdrop-filter: blur(8px);
	}

	.news-pin :global(svg) {
		width: 10px;
		height: 10px;
	}

	.news-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 24px;
	}

	.news-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 600;
		color: #8a8f99;
	}

	.news-meta .sep {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: #c9c2b9;
	}

	.news-featured h3 {
		margin: 10px 0 0;
		font-family: var(--font-display);
		font-size: clamp(22px, 2.4vw, 30px);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.news-featured p {
		margin: 10px 0 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
	}

	.news-more {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin-top: auto;
		padding-top: 16px;
		font-size: 13px;
		font-weight: 700;
		color: var(--orange-deep);
	}

	.news-more :global(svg) {
		width: 16px;
		height: 16px;
		flex: none;
	}

	@media (max-width: 640px) {
		.news-body {
			padding: 18px;
		}
	}

	/* Parallax dangkal: gambar lebih lambat dari kontennya.
	   Timeline dipasang pada .news-featured karena .news-media memakai overflow: hidden. */
	@supports (animation-timeline: view()) {
		.news-featured {
			view-timeline-name: --news-view;
			view-timeline-axis: block;
		}

		.news-media :global(img) {
			scale: 1.08;
			animation: parallax-y-soft linear both;
			animation-timeline: --news-view;
			animation-range: cover;
		}
	}
</style>
