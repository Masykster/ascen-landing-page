---
import Icon from '../ui/Icon.astro';
import { resourceTypeMeta, type ResourceType } from '../../lib/cbt-api';

interface Props {
	href: string;
	type: ResourceType;
	title: string;
	excerpt?: string;
	thumbnailUrl?: string | null;
	subject?: string | null;
	level?: string | null;
	cta?: string;
}

const {
	href,
	type,
	title,
	excerpt,
	thumbnailUrl = null,
	subject = null,
	level = null,
	cta,
} = Astro.props;

const meta = resourceTypeMeta(type);
const ctaLabel = cta || meta.cta;
const metaLine = [subject, level].filter(Boolean).join(' · ');
const typeIcon = type === 'worksheet' ? 'file' : type === 'material' ? 'book' : 'gamepad';
---

<a class:list={['resource-card', `resource-card--${type}`]} href={href}>
	<div class="resource-media">
		<img
			data-resource-image
			src={thumbnailUrl ?? undefined}
			alt={thumbnailUrl ? title : ''}
			loading="lazy"
			decoding="async"
			hidden={!thumbnailUrl}
		/>
		<div class="resource-placeholder" data-resource-placeholder hidden={Boolean(thumbnailUrl)} aria-hidden="true">
			<Icon name={typeIcon} size={34} />
			<span>{meta.label}</span>
		</div>
		<span class:list={['resource-badge', `resource-badge--${meta.tone}`]} data-resource-badge>
			{meta.label}
		</span>
	</div>
	<div class="resource-body">
		<p class="resource-meta" data-resource-meta hidden={!metaLine}>{metaLine}</p>
		<h3 data-resource-title>{title}</h3>
		{excerpt && <p class="resource-excerpt" data-resource-excerpt>{excerpt}</p>}
		<span class="resource-cta">
			<span data-resource-cta>{ctaLabel}</span>
			<Icon name="arrow" size={16} />
		</span>
	</div>
</a>

<style>
	.resource-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--line-warm);
		border-radius: var(--radius);
		background: #fff;
		transition:
			box-shadow 0.25s ease,
			transform 0.25s ease;
	}

	.resource-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.resource-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: #f3eee8;
	}

	.resource-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.resource-media img[hidden],
	.resource-placeholder[hidden] {
		display: none;
	}

	.resource-card:hover .resource-media img {
		transform: scale(1.03);
	}

	.resource-placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 9px;
		background: linear-gradient(145deg, #f8f1e7 0%, #f1e4d3 100%);
		color: #8a6244;
	}

	.resource-card--material .resource-placeholder {
		background: linear-gradient(145deg, #edf4ff 0%, #dae8ff 100%);
		color: #1d4ed8;
	}

	.resource-card--game .resource-placeholder {
		background: linear-gradient(145deg, #fff3e7 0%, #ffe1c5 100%);
		color: #c2410c;
	}

	.resource-placeholder :global(svg) {
		width: 34px;
		height: 34px;
		opacity: 0.9;
	}

	.resource-placeholder span {
		font-family: var(--font-mono);
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.resource-badge {
		position: absolute;
		top: 14px;
		left: 14px;
		display: inline-flex;
		align-items: center;
		padding: 5px 9px;
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.resource-badge--green {
		background: #dcf0de;
		color: #2f6b3a;
	}

	.resource-badge--blue {
		background: #dbe8ff;
		color: #1d4ed8;
	}

	.resource-badge--orange {
		background: #fde3cf;
		color: #c2410c;
	}

	.resource-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 22px;
	}

	.resource-body[hidden],
	.resource-meta[hidden] {
		display: none;
	}

	.resource-meta {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.resource-body h3 {
		margin: 9px 0 0;
		font-family: var(--font-display);
		font-size: clamp(21px, 2vw, 25px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--ink);
		text-wrap: balance;
	}

	.resource-excerpt {
		display: -webkit-box;
		overflow: hidden;
		margin: 10px 0 0;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
	}

	.resource-excerpt[hidden] {
		display: none;
	}

	.resource-cta {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin-top: auto;
		padding-top: 18px;
		font-size: 12.5px;
		font-weight: 700;
		color: var(--orange-deep);
	}

	.resource-cta :global(svg) {
		width: 16px;
		height: 16px;
		flex: none;
	}

	@media (max-width: 640px) {
		.resource-body {
			padding: 18px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.resource-card,
		.resource-media img {
			transition: none;
		}

		.resource-card:hover {
			transform: none;
		}

		.resource-card:hover .resource-media img {
			transform: none;
		}
	}
</style>
