---
import { testimonials } from '../../data/testimonials';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TestimonialCard from './TestimonialCard.astro';

const featured = testimonials.find((item) => item.featured) ?? testimonials[0];
const list = testimonials.filter((item) => item !== featured);
---

<section class="section" id="testimoni">
	<div class="container">
		<div class="section-head section-head--split">
			<div>
				<Eyebrow tone="blue" class="reveal">Kata mereka</Eyebrow>
				<h2 class="reveal">Cerita siswa yang naik level bersama Ascendemy</h2>
				<p class="reveal">
					Dari latihan harian, tryout, sampai olimpiade — mereka berbagi cara belajar yang
					paling efektif untuk naik kelas.
				</p>
			</div>
			<Button
				class="reveal"
				variant="ghost"
				href="https://www.instagram.com/ascendemy.ofc/"
				icon="arrow"
				external
			>
				Lihat di Instagram
			</Button>
		</div>

		<div class="testi-grid">
			<div class="testi-list reveal reveal-list">
				{list.map((item) => <TestimonialCard testimonial={item} />)}
			</div>
			<div class="testi-feature reveal reveal-card">
				<TestimonialCard testimonial={featured} variant="featured" />
			</div>
		</div>
	</div>
</section>

<style>
	.section {
		border-top: 1px solid var(--line-warm);
	}

	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.section-head--split {
		max-width: none;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 40px;
		text-align: left;
	}

	.section-head--split > div {
		max-width: 640px;
	}

	.section-head--split h2 {
		margin-bottom: 0;
	}

	.section-head--split p {
		margin-left: 0;
	}

	.testi-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: 22px;
		align-items: start;
	}

	.testi-list {
		display: grid;
		gap: 14px;
	}

	@media (min-width: 1100px) {
		.testi-feature {
			position: sticky;
			top: 110px;
		}
	}

	@media (max-width: 900px) {
		.testi-grid {
			grid-template-columns: 1fr;
		}

		.testi-feature {
			order: -1;
		}
	}

	@media (max-width: 640px) {
		.section-head {
			margin-bottom: 32px;
		}

		.section-head--split {
			display: block;
		}

		.section-head--split :global(.btn) {
			margin-top: 18px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
