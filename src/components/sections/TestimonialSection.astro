---
import { testimonials } from '../../data/testimonials';
import Button from '../ui/Button.astro';
import TestimonialCard from './TestimonialCard.astro';

// Kolom memakai subset data yang dirotasi supaya tiap kolom punya isi cukup
// untuk loop marquee, tanpa mengubah data testimoni.
const shifted = (offset: number) =>
	testimonials.map((_, index) => testimonials[(index + offset) % testimonials.length]);

const columns = [
	{ items: shifted(0).slice(0, 3), duration: 26, reverse: false },
	{ items: shifted(1).slice(0, 3), duration: 30, reverse: true },
	{ items: shifted(2).slice(0, 3), duration: 24, reverse: false },
];

const mobileItems = testimonials;
---

<section class="section" id="testimoni">
	<div class="container">
		<div class="section-head section-head--split">
			<div class="reveal">
				<h2>Cerita siswa yang naik level bersama Ascendemy</h2>
				<p>
					Dari latihan harian, tryout, sampai olimpiade — mereka berbagi cara belajar yang
					paling efektif untuk naik kelas.
				</p>
			</div>
			<Button
				class="reveal"
				variant="ghost"
				href="https://www.instagram.com/ascendemy.ofc/"
				icon="arrow"
				external
			>
				Lihat di Instagram
			</Button>
		</div>

		<div class="testi-marquee reveal reveal-card">
			{
				columns.map((column) => (
					<div
						class:list={['marquee', column.reverse && 'is-reverse']}
						style={`--duration:${column.duration}s`}
					>
						<div class="marquee-track">
							<div class="marquee-group">
								{column.items.map((item) => (
									<TestimonialCard testimonial={item} />
								))}
							</div>
							<div class="marquee-group" aria-hidden="true">
								{column.items.map((item) => (
									<TestimonialCard testimonial={item} />
								))}
							</div>
						</div>
					</div>
				))
			}

			<div class="marquee marquee--mobile" style="--duration:28s">
				<div class="marquee-track">
					<div class="marquee-group">
						{mobileItems.map((item) => <TestimonialCard testimonial={item} />)}
					</div>
					<div class="marquee-group" aria-hidden="true">
						{mobileItems.map((item) => <TestimonialCard testimonial={item} />)}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.section {
		border-top: 1px solid var(--line-warm);
	}

	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.section-head--split {
		max-width: none;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 40px;
		text-align: left;
	}

	.section-head--split > div {
		max-width: 640px;
	}

	.section-head--split h2 {
		margin-bottom: 0;
	}

	.section-head--split p {
		margin-left: 0;
	}

	/* --- vertical marquee -------------------------------------------------- */

	.testi-marquee {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		height: clamp(420px, 42vw, 520px);
	}

	.testi-marquee::before,
	.testi-marquee::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		z-index: 2;
		height: 96px;
		pointer-events: none;
	}

	.testi-marquee::before {
		top: 0;
		background: linear-gradient(180deg, var(--bg), rgba(253, 253, 253, 0));
	}

	.testi-marquee::after {
		bottom: 0;
		background: linear-gradient(0deg, var(--bg), rgba(253, 253, 253, 0));
	}

	.marquee {
		position: relative;
		height: 100%;
		overflow: hidden;
	}

	.marquee-track {
		display: flex;
		flex-direction: column;
		animation: testi-scroll var(--duration, 26s) linear infinite;
		will-change: transform;
	}

	.marquee.is-reverse .marquee-track {
		animation-direction: reverse;
	}

	.marquee-group {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-bottom: 14px;
	}

	.marquee--mobile {
		display: none;
	}

	@keyframes testi-scroll {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-50%);
		}
	}

	@media (hover: hover) {
		.marquee:hover .marquee-track {
			animation-play-state: paused;
		}
	}

	@media (max-width: 1080px) {
		.testi-marquee {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.marquee:nth-child(3) {
			display: none;
		}
	}

	@media (max-width: 680px) {
		.testi-marquee {
			grid-template-columns: minmax(0, 1fr);
			height: 440px;
		}

		.marquee:not(.marquee--mobile) {
			display: none;
		}

		.marquee--mobile {
			display: block;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee {
			overflow-y: auto;
		}

		.marquee-track {
			animation: none;
		}

		.marquee-group[aria-hidden='true'] {
			display: none;
		}

		.testi-marquee::before,
		.testi-marquee::after {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.section-head {
			margin-bottom: 32px;
		}

		.section-head--split {
			display: block;
		}

		.section-head--split :global(.btn) {
			margin-top: 18px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
