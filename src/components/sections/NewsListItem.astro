---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	image: ImageMetadata;
	alt: string;
	date: string;
	category: string;
	title: string;
}

const { href, image, alt, date, category, title } = Astro.props;
---

<a class="news-item" href={href}>
	<Image
		src={image}
		alt={alt}
		widths={[118, 236]}
		sizes="118px"
		loading="lazy"
	/>
	<div>
		<div class="news-meta">
			<span>{date}</span>
			<span class="sep"></span>
			<span>{category}</span>
		</div>
		<h4>{title}</h4>
	</div>
</a>

<style>
	.news-item {
		display: grid;
		grid-template-columns: 118px minmax(0, 1fr);
		gap: 14px;
		align-items: center;
		padding: 14px;
		border-bottom: 1px solid #f1ece5;
		transition: background 0.2s ease;
	}

	.news-item:last-child {
		border-bottom: 0;
	}

	.news-item:hover {
		background: #fffaf4;
	}

	.news-item :global(img) {
		width: 100%;
		height: 88px;
		object-fit: cover;
		border-radius: 10px;
	}

	.news-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 600;
		color: #8a8f99;
	}

	.news-meta .sep {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: #c9c2b9;
	}

	.news-item h4 {
		margin: 4px 0 0;
		font-size: 14px;
		font-weight: 700;
		line-height: 1.35;
		color: var(--ink);
	}

	@media (max-width: 640px) {
		.news-item {
			grid-template-columns: 92px minmax(0, 1fr);
			padding: 12px;
		}

		.news-item :global(img) {
			height: 72px;
		}

		.news-item h4 {
			font-size: 13px;
		}
	}
</style>
