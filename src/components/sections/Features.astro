---
import kompetisiCover from '../../assets/images/kompetisi-amo-2026.avif';
import latihan1 from '../../assets/images/bundles/latihan-matematika-1.avif';
import latihan2 from '../../assets/images/bundles/latihan-matematika-2.avif';
import latihan3 from '../../assets/images/bundles/latihan-matematika-3.avif';
import tryout1 from '../../assets/images/bundles/tryout-tka-utbk-1.avif';
import tryout2 from '../../assets/images/bundles/tryout-tka-utbk-2.avif';
import tryout3 from '../../assets/images/bundles/tryout-tka-utbk-3.avif';
import FeatureCard from './FeatureCard.astro';

const bundleLayers = ['front', 'back-a', 'back-b'];

const tryoutBundles = [
	{
		src: tryout1.src,
		alt: 'Paket Tryout TKA & UTBK 1',
	},
	{
		src: tryout2.src,
		alt: 'Paket Tryout UTBK 2',
	},
	{
		src: tryout3.src,
		alt: 'Paket Tryout UTBK 3',
	},
];

const latihanBundles = [
	{
		src: latihan1.src,
		alt: 'Paket Latihan Soal Matematika 1',
	},
	{
		src: latihan2.src,
		alt: 'Paket Latihan Soal Matematika 2',
	},
	{
		src: latihan3.src,
		alt: 'Paket Latihan Soal Matematika 3',
	},
];
---

<section class="section" id="fitur">
	<div class="fitur-geometry" aria-hidden="true">
		<span class="fitur-shape fitur-shape--orbit"></span>
		<span class="fitur-shape fitur-shape--square"></span>
		<svg
			class="fitur-shape fitur-shape--triangle"
			width="144"
			height="124"
			viewBox="0 0 144 124"
			fill="none"
		>
			<defs>
				<linearGradient
					id="fitur-triangle-line"
					x1="10"
					y1="118"
					x2="134"
					y2="6"
					gradientUnits="userSpaceOnUse"
				>
					<stop stop-color="#2563eb" />
					<stop offset="1" stop-color="#38bdf8" />
				</linearGradient>
			</defs>
			<path
				d="M72 5 139 116H5L72 5Z"
				stroke="url(#fitur-triangle-line)"
				stroke-width="1.5"
				stroke-linejoin="round"
			/>
			<path
				d="M30 116h84"
				stroke="url(#fitur-triangle-line)"
				stroke-width="1.5"
				stroke-linecap="round"
				opacity=".7"
			/>
		</svg>
		<span class="fitur-shape fitur-shape--diamond"></span>
		<span class="fitur-shape fitur-shape--ring"></span>
		<span class="fitur-shape fitur-shape--arc"></span>
		<span class="fitur-glyph fitur-glyph--pi">π</span>
		<span class="fitur-glyph fitur-glyph--root">√</span>
		<span class="fitur-glyph fitur-glyph--plus">+</span>
		<span class="fitur-glyph fitur-glyph--divide">÷</span>
		<span class="fitur-glyph fitur-glyph--sigma">∑</span>
		<span class="fitur-glyph fitur-glyph--theta">θ</span>
		<span class="fitur-glyph fitur-glyph--times">×</span>
		<span class="fitur-glyph fitur-glyph--infinity">∞</span>
	</div>
	<div class="container">
		<div class="section-head">
			<h2 class="reveal">Belajar dengan cara yang paling cocok untukmu</h2>
			<p class="reveal">
				Mulai dari latihan harian, uji kesiapan dengan tryout, lalu buktikan kemampuanmu di
				kompetisi nasional.
			</p>
		</div>

		<div class="feature-grid" data-stagger>
			<FeatureCard
				class="reveal reveal-card"
				variant="orange"
				title="Kompetisi"
				description="Uji kemampuanmu di kompetisi nasional. 100% online, e-sertifikat, dan hadiah uang tunai untuk juara umum."
				linkLabel="Lihat kompetisi"
				href="https://cbt.ascendemy.id/kompetisi"
				plate={false}
			>
				<img
					class="competition-cover"
					src={kompetisiCover.src}
					alt="Banner Ascendemy Mathematics Olympiad 2026"
					width="1200"
					height="800"
					loading="lazy"
					decoding="async"
				/>
			</FeatureCard>

			<FeatureCard
				class="reveal reveal-card"
				variant="blue"
				title="Tryout TKA & UTBK"
				description="Simulasi ujian dengan timer, analisis skor, dan pembahasan. Rasakan pengalaman Computer Based Test yang sesungguhnya."
				linkLabel="Mulai tryout"
				href="https://cbt.ascendemy.id/tryout"
				plate={false}
			>
				<div class="bundle-stack">
					{tryoutBundles.map((image, index) => (
						<img
							class:list={['bundle-card', `bundle-card--${bundleLayers[index]}`]}
							src={image.src}
							alt={image.alt}
							width="1000"
							height="1481"
							loading="lazy"
							decoding="async"
						/>
					))}
				</div>
			</FeatureCard>

			<FeatureCard
				class="reveal reveal-card"
				variant="cream"
				title="Latihan soal adaptif"
				description="Ribuan soal matematika dari SMP hingga SMA, lengkap dengan pembahasan langkah demi langkah."
				linkLabel="Mulai latihan"
				href="https://cbt.ascendemy.id/latihan"
				plate={false}
			>
				<div class="bundle-stack">
					{latihanBundles.map((image, index) => (
						<img
							class:list={['bundle-card', `bundle-card--${bundleLayers[index]}`]}
							src={image.src}
							alt={image.alt}
							width="1000"
							height="1481"
							loading="lazy"
							decoding="async"
						/>
					))}
				</div>
			</FeatureCard>
		</div>
	</div>
</section>

<style>
	/* transisi zona-es → zona-krem: tint es pucat di atas section pertama */
	.section {
		background-image: linear-gradient(180deg, #f6faff 0%, rgba(246, 250, 255, 0) 160px);
	}

	.container {
		position: relative;
		z-index: 1;
	}

	/* Dekorasi geometri: warna dan gradien mengikuti MathScramble di hero/CTA. */
	.fitur-geometry {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.fitur-shape {
		position: absolute;
		display: block;
	}

	.fitur-shape--orbit {
		top: 7%;
		left: -92px;
		width: clamp(240px, 24vw, 340px);
		aspect-ratio: 1;
		border: 1.5px dashed rgba(37, 99, 235, 0.34);
		border-radius: 50%;
		background-image: linear-gradient(
			135deg,
			transparent 49.6%,
			rgba(37, 99, 235, 0.12) 50%,
			transparent 50.4%
		);
	}

	.fitur-shape--orbit::before {
		content: '';
		position: absolute;
		inset: 16%;
		border: 1px solid rgba(37, 99, 235, 0.16);
		border-radius: inherit;
	}

	.fitur-shape--orbit::after {
		content: '';
		position: absolute;
		top: 14%;
		right: 18%;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(37, 99, 235, 0.35);
		box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.08);
	}

	.fitur-shape--square {
		top: 12%;
		right: -42px;
		width: clamp(120px, 11vw, 164px);
		aspect-ratio: 1;
		border: 1.5px solid rgba(249, 115, 22, 0.3);
		border-radius: 10px;
		rotate: 12deg;
	}

	.fitur-shape--square::before {
		content: '';
		position: absolute;
		inset: 18px;
		border: 1px solid rgba(249, 115, 22, 0.15);
		border-radius: 5px;
	}

	.fitur-shape--square::after {
		content: '';
		position: absolute;
		left: -7px;
		bottom: 20%;
		width: 14px;
		height: 1px;
		background: rgba(249, 115, 22, 0.3);
	}

	.fitur-shape--triangle {
		right: 1.5%;
		bottom: 4%;
		width: clamp(100px, 10vw, 144px);
		height: auto;
		opacity: 0.5;
		rotate: -4deg;
	}

	.fitur-shape--diamond {
		bottom: 30%;
		left: -24px;
		width: clamp(88px, 8vw, 112px);
		aspect-ratio: 1;
		border: 1.5px solid rgba(37, 99, 235, 0.3);
		border-radius: 9px;
		rotate: 45deg;
	}

	.fitur-shape--diamond::before {
		content: '';
		position: absolute;
		inset: 14px;
		border: 1px solid rgba(37, 99, 235, 0.13);
		border-radius: 5px;
	}

	.fitur-shape--ring {
		top: 54%;
		right: -48px;
		width: clamp(150px, 15vw, 210px);
		aspect-ratio: 1;
		border: 1.5px solid rgba(249, 115, 22, 0.3);
		border-radius: 50%;
	}

	.fitur-shape--ring::before {
		content: '';
		position: absolute;
		inset: 22%;
		border: 1px dashed rgba(249, 115, 22, 0.15);
		border-radius: 50%;
	}

	.fitur-shape--ring::after {
		content: '';
		position: absolute;
		top: 12%;
		right: 18%;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(249, 115, 22, 0.3);
	}

	.fitur-shape--arc {
		bottom: 2.5%;
		left: 6%;
		width: clamp(130px, 13vw, 180px);
		aspect-ratio: 1;
		border: 1.5px solid rgba(249, 115, 22, 0.26);
		border-left-color: transparent;
		border-bottom-color: transparent;
		border-radius: 50%;
		rotate: -18deg;
	}

	.fitur-glyph {
		position: absolute;
		font-family: var(--font-mono);
		font-size: clamp(20px, 2.2vw, 32px);
		font-weight: 600;
		line-height: 1;
		opacity: 0.42;
		color: transparent;
		background-clip: text;
		-webkit-background-clip: text;
		user-select: none;
	}

	.fitur-glyph--pi {
		top: 37%;
		left: 4.2%;
		background-image: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
		rotate: -8deg;
	}

	.fitur-glyph--root {
		top: 48%;
		right: 3.8%;
		font-size: clamp(26px, 3vw, 42px);
		background-image: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
		rotate: 6deg;
	}

	.fitur-glyph--plus {
		bottom: 17%;
		left: 8%;
		background-image: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
		rotate: 10deg;
	}

	.fitur-glyph--divide {
		top: 16%;
		right: 11%;
		font-size: clamp(18px, 1.7vw, 24px);
		background-image: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
		rotate: -7deg;
	}

	.fitur-glyph--sigma {
		top: 6.5%;
		left: 19%;
		font-size: clamp(18px, 1.9vw, 26px);
		background-image: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
		rotate: -10deg;
	}

	.fitur-glyph--theta {
		top: 31%;
		right: 5.5%;
		font-size: clamp(20px, 2.1vw, 30px);
		background-image: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
		rotate: 8deg;
	}

	.fitur-glyph--times {
		bottom: 9%;
		right: 22%;
		font-size: clamp(18px, 1.8vw, 24px);
		background-image: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
		rotate: -4deg;
	}

	.fitur-glyph--infinity {
		bottom: 6%;
		left: 19%;
		font-size: clamp(24px, 2.6vw, 36px);
		background-image: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
		rotate: 3deg;
	}

	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.competition-cover {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 16px 30px -22px rgba(35, 39, 46, 0.6);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	:global(.feature-card:hover) .competition-cover,
	:global(.feature-card:focus-visible) .competition-cover {
		transform: translateY(-3px) rotate(-0.8deg);
	}

	.bundle-stack {
		position: relative;
		width: min(100%, 180px);
		aspect-ratio: 2 / 3;
		margin: 0 auto;
	}

	.bundle-card {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 16px 30px -22px rgba(35, 39, 46, 0.6);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.bundle-card--front {
		z-index: 3;
	}

	.bundle-card--back-a {
		z-index: 2;
		transform: translate(-15%, 4%) rotate(-6deg) scale(0.96);
	}

	.bundle-card--back-b {
		z-index: 1;
		transform: translate(15%, -4%) rotate(7deg) scale(0.93);
	}

	/* :global dipakai karena .feature-card dirender oleh komponen FeatureCard,
	   jadi elemen itu tidak membawa scope id dari stylesheet ini. */
	:global(.feature-card:hover) .bundle-card--back-a {
		transform: translate(-26%, 6%) rotate(-11deg) scale(0.96);
	}

	:global(.feature-card:hover) .bundle-card--back-b {
		transform: translate(26%, -6%) rotate(11deg) scale(0.93);
	}

	:global(.feature-card:focus-visible) .bundle-card--back-a {
		transform: translate(-26%, 6%) rotate(-11deg) scale(0.96);
	}

	:global(.feature-card:focus-visible) .bundle-card--back-b {
		transform: translate(26%, -6%) rotate(11deg) scale(0.93);
	}

	@media (max-width: 900px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.fitur-shape--orbit {
			top: 40px;
			left: -150px;
			width: 230px;
		}

		.fitur-shape--square,
		.fitur-shape--triangle,
		.fitur-shape--diamond,
		.fitur-shape--ring,
		.fitur-shape--arc,
		.fitur-glyph--plus,
		.fitur-glyph--divide,
		.fitur-glyph--sigma,
		.fitur-glyph--theta,
		.fitur-glyph--times,
		.fitur-glyph--infinity {
			display: none;
		}

		.fitur-glyph {
			font-size: 20px;
			opacity: 0.28;
		}

		.fitur-glyph--pi {
			top: 30%;
			left: 1.5%;
		}

		.fitur-glyph--root {
			top: 55%;
			right: 1.5%;
			font-size: 26px;
		}

		.section-head {
			margin-bottom: 32px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
