---
import kompetisiCover from '../../assets/images/kompetisi-amo-2026.avif';
import latihan1 from '../../assets/images/bundles/latihan-matematika-1.avif';
import latihan2 from '../../assets/images/bundles/latihan-matematika-2.avif';
import latihan3 from '../../assets/images/bundles/latihan-matematika-3.avif';
import tryout1 from '../../assets/images/bundles/tryout-tka-utbk-1.avif';
import tryout2 from '../../assets/images/bundles/tryout-tka-utbk-2.avif';
import tryout3 from '../../assets/images/bundles/tryout-tka-utbk-3.avif';
import FeatureCard from './FeatureCard.astro';

const bundleLayers = ['front', 'back-a', 'back-b'];

const tryoutBundles = [
	{
		src: tryout1.src,
		alt: 'Paket Tryout TKA & UTBK 1',
	},
	{
		src: tryout2.src,
		alt: 'Paket Tryout UTBK 2',
	},
	{
		src: tryout3.src,
		alt: 'Paket Tryout UTBK 3',
	},
];

const latihanBundles = [
	{
		src: latihan1.src,
		alt: 'Paket Latihan Soal Matematika 1',
	},
	{
		src: latihan2.src,
		alt: 'Paket Latihan Soal Matematika 2',
	},
	{
		src: latihan3.src,
		alt: 'Paket Latihan Soal Matematika 3',
	},
];
---

<section class="section" id="fitur">
	<div class="container">
		<div class="section-head">
			<h2 class="reveal">Belajar dengan cara yang paling cocok untukmu</h2>
			<p class="reveal">
				Mulai dari latihan harian, uji kesiapan dengan tryout, lalu buktikan kemampuanmu di
				kompetisi nasional.
			</p>
		</div>

		<div class="feature-grid" data-stagger>
			<FeatureCard
				class="reveal reveal-card"
				variant="orange"
				title="Kompetisi"
				description="Uji kemampuanmu di kompetisi nasional. 100% online, e-sertifikat, dan hadiah uang tunai untuk juara umum."
				linkLabel="Lihat kompetisi"
				href="https://cbt.ascendemy.id/kompetisi"
				plate={false}
			>
				<img
					class="competition-cover"
					src={kompetisiCover.src}
					alt="Banner Ascendemy Mathematics Olympiad 2026"
					width="1200"
					height="800"
					loading="lazy"
					decoding="async"
				/>
			</FeatureCard>

			<FeatureCard
				class="reveal reveal-card"
				variant="blue"
				title="Tryout TKA & UTBK"
				description="Simulasi ujian dengan timer, analisis skor, dan pembahasan. Rasakan pengalaman Computer Based Test yang sesungguhnya."
				linkLabel="Mulai tryout"
				href="https://cbt.ascendemy.id/tryout"
				plate={false}
			>
				<div class="bundle-stack">
					{tryoutBundles.map((image, index) => (
						<img
							class:list={['bundle-card', `bundle-card--${bundleLayers[index]}`]}
							src={image.src}
							alt={image.alt}
							width="1000"
							height="1481"
							loading="lazy"
							decoding="async"
						/>
					))}
				</div>
			</FeatureCard>

			<FeatureCard
				class="reveal reveal-card"
				variant="cream"
				title="Latihan soal adaptif"
				description="Ribuan soal matematika dari SMP hingga SMA, lengkap dengan pembahasan langkah demi langkah."
				linkLabel="Mulai latihan"
				href="https://cbt.ascendemy.id/latihan"
				plate={false}
			>
				<div class="bundle-stack">
					{latihanBundles.map((image, index) => (
						<img
							class:list={['bundle-card', `bundle-card--${bundleLayers[index]}`]}
							src={image.src}
							alt={image.alt}
							width="1000"
							height="1481"
							loading="lazy"
							decoding="async"
						/>
					))}
				</div>
			</FeatureCard>
		</div>
	</div>
</section>

<style>
	/* transisi zona-es → zona-krem: tint es pucat di atas section pertama */
	.section {
		background-image: linear-gradient(180deg, #f6faff 0%, rgba(246, 250, 255, 0) 160px);
	}

	.section-head {
		max-width: 760px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-head h2 {
		margin: 14px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(34px, 4.2vw, 52px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.section-head p {
		margin: 16px auto 0;
		max-width: 620px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--muted);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.competition-cover {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 16px 30px -22px rgba(35, 39, 46, 0.6);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	:global(.feature-card:hover) .competition-cover,
	:global(.feature-card:focus-visible) .competition-cover {
		transform: translateY(-3px) rotate(-0.8deg);
	}

	.bundle-stack {
		position: relative;
		width: min(100%, 180px);
		aspect-ratio: 2 / 3;
		margin: 0 auto;
	}

	.bundle-card {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 16px 30px -22px rgba(35, 39, 46, 0.6);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.bundle-card--front {
		z-index: 3;
	}

	.bundle-card--back-a {
		z-index: 2;
		transform: translate(-15%, 4%) rotate(-6deg) scale(0.96);
	}

	.bundle-card--back-b {
		z-index: 1;
		transform: translate(15%, -4%) rotate(7deg) scale(0.93);
	}

	/* :global dipakai karena .feature-card dirender oleh komponen FeatureCard,
	   jadi elemen itu tidak membawa scope id dari stylesheet ini. */
	:global(.feature-card:hover) .bundle-card--back-a {
		transform: translate(-26%, 6%) rotate(-11deg) scale(0.96);
	}

	:global(.feature-card:hover) .bundle-card--back-b {
		transform: translate(26%, -6%) rotate(11deg) scale(0.93);
	}

	:global(.feature-card:focus-visible) .bundle-card--back-a {
		transform: translate(-26%, 6%) rotate(-11deg) scale(0.96);
	}

	:global(.feature-card:focus-visible) .bundle-card--back-b {
		transform: translate(26%, -6%) rotate(11deg) scale(0.93);
	}

	@media (max-width: 900px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.section-head {
			margin-bottom: 32px;
		}

		.section-head h2 {
			font-size: clamp(30px, 8vw, 38px);
		}
	}
</style>
