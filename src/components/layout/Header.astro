---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { navLinks } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="#top" aria-label="Ascendemy, kembali ke atas">
			<Image
				src={logo}
				alt="Ascendemy"
				widths={[86, 112, 172, 224]}
				sizes="(max-width: 640px) 86px, 112px"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
		</a>

		<nav class="nav-desktop" aria-label="Navigasi utama">
			{navLinks.map((link, index) => (
				<a class:list={['nav-link', index === 0 && 'is-active']} href={link.href}>
					{link.label}
				</a>
			))}
		</nav>

		<div class="header-actions">
			<Button variant="ghost" href="https://cbt.ascendemy.id/">Masuk</Button>
			<Button href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
			<button
				class="nav-toggle"
				type="button"
				aria-controls="nav-mobile"
				aria-expanded="false"
				aria-label="Buka menu"
			>
				<Icon name="menu" size={18} />
			</button>
		</div>
	</div>

	<div class="nav-mobile" id="nav-mobile">
		<div class="container">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href="https://cbt.ascendemy.id/">Masuk</a>
			<Button href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const mobileNav = document.getElementById('nav-mobile');

	if (header) {
		const onScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 8);
		};

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		if (toggle && mobileNav) {
			toggle.addEventListener('click', () => {
				const open = mobileNav.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
			});

			mobileNav.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				if (target.closest('a')) {
					mobileNav.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
					toggle.setAttribute('aria-label', 'Buka menu');
				}
			});
		}

		const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link[href^='#']"));
		const sections = links
			.map((link) => document.querySelector(link.getAttribute('href') ?? ''))
			.filter((section): section is Element => Boolean(section));

		if ('IntersectionObserver' in window && sections.length) {
			const spy = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						links.forEach((link) => {
							link.classList.toggle(
								'is-active',
								link.getAttribute('href') === `#${entry.target.id}`,
							);
						});
					});
				},
				{ rootMargin: '-40% 0px -52% 0px', threshold: 0 },
			);

			sections.forEach((section) => spy.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 12px 0 0;
		background: transparent;
	}

	.header-inner {
		height: 68px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		padding: 8px 10px 8px 18px;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 999px;
		background: rgba(253, 249, 244, 0.64);
		box-shadow:
			0 18px 40px -28px rgba(35, 39, 46, 0.45),
			inset 0 1px 0 rgba(255, 255, 255, 0.7);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
		transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.site-header.is-scrolled .header-inner {
		background: rgba(253, 249, 244, 0.82);
		border-color: rgba(236, 231, 223, 0.9);
		box-shadow:
			0 22px 48px -28px rgba(35, 39, 46, 0.5),
			inset 0 1px 0 rgba(255, 255, 255, 0.75);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		grid-column: 1;
	}

	.brand :global(img) {
		width: 112px;
		height: auto;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		justify-self: center;
		grid-column: 2;
		gap: 2px;
	}

	.nav-link {
		padding: 9px 13px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		color: var(--text);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-link:hover {
		background: rgba(255, 255, 255, 0.62);
		color: var(--ink);
	}

	.nav-link.is-active {
		color: var(--orange-deep);
		background: rgba(255, 244, 234, 0.92);
	}

	.header-actions {
		display: flex;
		align-items: center;
		justify-self: end;
		grid-column: 3;
		gap: 10px;
	}

	.nav-toggle {
		display: none;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.65);
		background: rgba(255, 255, 255, 0.55);
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--ink);
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.nav-toggle:hover {
		background: rgba(255, 255, 255, 0.82);
	}

	.nav-toggle :global(svg) {
		width: 18px;
		height: 18px;
	}

	.nav-mobile {
		display: none;
		padding: 8px 0 0;
	}

	.nav-mobile.is-open {
		display: block;
		animation: nav-in 0.22s ease both;
	}

	.nav-mobile .container {
		display: grid;
		gap: 4px;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.6);
		border-radius: 24px;
		background: rgba(253, 249, 244, 0.88);
		box-shadow:
			0 20px 45px -28px rgba(35, 39, 46, 0.45),
			inset 0 1px 0 rgba(255, 255, 255, 0.7);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
	}

	.nav-mobile a {
		padding: 12px 10px;
		border-radius: 12px;
		font-weight: 600;
		font-size: 15px;
	}

	.nav-mobile a:hover {
		background: rgba(255, 255, 255, 0.7);
	}

	.nav-mobile :global(.btn) {
		margin-top: 8px;
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.header-inner,
		.nav-mobile .container {
			background: rgba(253, 249, 244, 0.96);
		}
	}

	@media (max-width: 980px) {
		.nav-desktop,
		.header-actions :global(.btn-ghost) {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 640px) {
		.header-inner {
			height: 62px;
			gap: 12px;
			padding: 6px 8px 6px 14px;
		}

		.brand :global(img) {
			width: 86px;
			height: auto;
		}

		.header-actions :global(.btn-primary) {
			display: none;
		}
	}
</style>
