---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { navLinks } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = pathname === '/' || pathname === '/index.html';
const resolveHref = (href: string) => (href.startsWith('#') && !isHome ? `/${href}` : href);
const isActive = (href: string, index: number) =>
	href.startsWith('/')
		? pathname === href.replace(/\/+$/, '') ||
			(href === '/blog' && pathname.startsWith('/blog/')) ||
			(href === '/resource' && pathname.startsWith('/resource/'))
		: isHome && index === 0;
---

<header class:list={['site-header', isHome && 'site-header--home']}>
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Ascendemy, kembali ke beranda">
			<Image
				src={logo}
				alt="Ascendemy"
				widths={[86, 112, 172, 224]}
				sizes="(max-width: 640px) 86px, 112px"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
		</a>

		<nav class="nav-desktop" aria-label="Navigasi utama">
			{navLinks.map((link, index) => (
				<a
					class:list={['nav-link', isActive(link.href, index) && 'is-active']}
					href={resolveHref(link.href)}
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="header-actions">
			<Button variant="ghost" href="https://cbt.ascendemy.id/">Masuk</Button>
			<Button href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
			<button
				class="nav-toggle"
				type="button"
				aria-controls="nav-mobile"
				aria-expanded="false"
				aria-label="Buka menu"
			>
				<Icon name="menu" size={18} />
			</button>
		</div>
	</div>

	<div class="nav-mobile" id="nav-mobile">
		<div class="container">
			<nav class="mobile-nav" aria-label="Navigasi mobile">
				{
					navLinks.map((link) => {
						const letters = [...link.label];
						return (
							<a class="mobile-link" href={resolveHref(link.href)} aria-label={link.label}>
								<span class="mobile-roll" aria-hidden="true">
									{letters.map((char, index) => {
										const delay = Math.abs(index - (letters.length - 1) / 2) * 0.035;
										return (
											<span
												class="roll-char"
												style={`--delay:${delay.toFixed(3)}s`}
											>
												<span class="roll-face">{char === ' ' ? '\u00A0' : char}</span>
												<span class="roll-face roll-face--ghost">
													{char === ' ' ? '\u00A0' : char}
												</span>
											</span>
										);
									})}
								</span>
							</a>
						);
					})
				}
			</nav>
			<div class="mobile-actions">
				<Button href="https://cbt.ascendemy.id/" icon="arrow">Masuk</Button>
				<Button variant="ghost" href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const mobileNav = document.getElementById('nav-mobile');

	if (header) {
		const onScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 8);
		};

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		if (toggle && mobileNav) {
			const setOpen = (open: boolean) => {
				mobileNav.classList.toggle('is-open', open);
				header.classList.toggle('is-menu-open', open);
				document.body.classList.toggle('nav-open', open);
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
			};

			toggle.addEventListener('click', () => {
				setOpen(!mobileNav.classList.contains('is-open'));
			});

			mobileNav.addEventListener('click', (event) => {
				if ((event.target as HTMLElement).closest('a')) setOpen(false);
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && mobileNav.classList.contains('is-open')) {
					setOpen(false);
				}
			});
		}

		const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link[href^='#']"));
		const sections = links
			.map((link) => document.querySelector(link.getAttribute('href') ?? ''))
			.filter((section): section is Element => Boolean(section));

		if ('IntersectionObserver' in window && sections.length) {
			const spy = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						links.forEach((link) => {
							link.classList.toggle(
								'is-active',
								link.getAttribute('href') === `#${entry.target.id}`,
							);
						});
					});
				},
				{ rootMargin: '-40% 0px -52% 0px', threshold: 0 },
			);

			sections.forEach((section) => spy.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0;
		background: rgba(253, 249, 244, 0.8);
		border-bottom: 1px solid rgba(236, 231, 223, 0.9);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
		transition:
			padding 0.3s ease,
			background-color 0.3s ease,
			border-color 0.3s ease,
			backdrop-filter 0.3s ease;
	}

	/* Beranda: header menyatu dengan gradasi hero di belakangnya. */
	.site-header--home {
		background: transparent;
		border-bottom-color: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	.header-inner {
		position: relative;
		z-index: 1;
		height: 68px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		padding: 8px 10px 8px 18px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		box-shadow: none;
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			backdrop-filter 0.25s ease;
	}

	.site-header.is-scrolled {
		padding: 12px 0 0;
		background: transparent;
		border-bottom-color: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	/* menu full-screen: matikan backdrop-filter header agar overlay bisa
	   menempel ke viewport (backdrop-filter membuat containing block) */
	.site-header.is-menu-open {
		background: transparent;
		border-bottom-color: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		transition: none;
	}

	.site-header.is-scrolled .header-inner {
		background: rgba(253, 249, 244, 0.82);
		border-color: rgba(236, 231, 223, 0.9);
		box-shadow:
			0 22px 48px -28px rgba(35, 39, 46, 0.5),
			inset 0 1px 0 rgba(255, 255, 255, 0.75);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		grid-column: 1;
	}

	.brand :global(img) {
		width: 112px;
		height: auto;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		justify-self: center;
		grid-column: 2;
		gap: 2px;
	}

	.nav-link {
		padding: 9px 13px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		color: var(--text);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-link:hover {
		background: rgba(255, 255, 255, 0.62);
		color: var(--ink);
	}

	.nav-link.is-active {
		color: var(--orange-deep);
		background: rgba(255, 244, 234, 0.92);
	}

	.header-actions {
		display: flex;
		align-items: center;
		justify-self: end;
		grid-column: 3;
		gap: 10px;
	}

	.nav-toggle {
		display: none;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.65);
		background: rgba(255, 255, 255, 0.55);
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--ink);
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.nav-toggle:hover {
		background: rgba(255, 255, 255, 0.82);
	}

	.nav-toggle :global(svg) {
		width: 18px;
		height: 18px;
	}

	.nav-mobile {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		padding: 0;
		background: var(--cream);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.nav-mobile.is-open {
		display: block;
		animation: nav-in 0.22s ease both;
	}

	.nav-mobile .container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 24px;
		min-height: 100%;
		padding: 92px 8px 40px;
	}

	:global(body.nav-open) {
		overflow: hidden;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		padding: 4px 0 16px;
	}

	.mobile-link {
		display: flex;
		justify-content: center;
		padding: 2px 0;
		font-family: var(--font-display);
		font-size: clamp(36px, 11vw, 52px);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.mobile-roll {
		display: flex;
		line-height: 0.85;
	}

	.roll-char {
		position: relative;
		display: inline-block;
		overflow: hidden;
		height: 0.85em;
	}

	.roll-face {
		display: block;
		transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: var(--delay, 0ms);
		will-change: transform;
	}

	.roll-face--ghost {
		position: absolute;
		inset: 0;
		transform: translateY(100%);
	}

	.mobile-link:hover .roll-face,
	.mobile-link:focus-visible .roll-face {
		transform: translateY(-100%);
	}

	.mobile-link:hover .roll-face--ghost,
	.mobile-link:focus-visible .roll-face--ghost {
		transform: translateY(0);
	}

	.mobile-actions {
		display: grid;
		gap: 8px;
		width: min(100%, 340px);
	}

	.mobile-actions :global(.btn) {
		width: 100%;
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.site-header {
			background: rgba(253, 249, 244, 0.96);
		}

		.site-header.is-scrolled .header-inner {
			background: rgba(253, 249, 244, 0.96);
		}
	}

	@media (max-width: 980px) {
		.nav-desktop,
		.header-actions :global(.btn-ghost) {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 640px) {
		.header-inner {
			height: 62px;
			gap: 12px;
			padding: 6px 8px 6px 14px;
		}

		.brand :global(img) {
			width: 86px;
			height: auto;
		}

		.header-actions :global(.btn-primary) {
			display: none;
		}
	}
</style>
