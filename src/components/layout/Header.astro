---
import logo from '../../assets/images/logo2.svg';
import { navLinks } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="#top" aria-label="Ascendemy, kembali ke atas">
			<img src={logo.src} alt="Ascendemy" width="736" height="291" />
		</a>

		<nav class="nav-desktop" aria-label="Navigasi utama">
			{navLinks.map((link, index) => (
				<a class:list={['nav-link', index === 0 && 'is-active']} href={link.href}>
					{link.label}
				</a>
			))}
		</nav>

		<div class="header-actions">
			<Button variant="ghost" href="https://cbt.ascendemy.id/">Masuk</Button>
			<Button href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
			<button
				class="nav-toggle"
				type="button"
				aria-controls="nav-mobile"
				aria-expanded="false"
				aria-label="Buka menu"
			>
				<Icon name="menu" size={18} />
			</button>
		</div>
	</div>

	<div class="nav-mobile" id="nav-mobile">
		<div class="container">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href="https://cbt.ascendemy.id/">Masuk</a>
			<Button href="https://cbt.ascendemy.id/register">Daftar gratis</Button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const mobileNav = document.getElementById('nav-mobile');

	if (header) {
		const onScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 8);
		};

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		if (toggle && mobileNav) {
			toggle.addEventListener('click', () => {
				const open = mobileNav.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
			});

			mobileNav.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				if (target.closest('a')) {
					mobileNav.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
					toggle.setAttribute('aria-label', 'Buka menu');
				}
			});
		}

		const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link[href^='#']"));
		const sections = links
			.map((link) => document.querySelector(link.getAttribute('href') ?? ''))
			.filter((section): section is Element => Boolean(section));

		if ('IntersectionObserver' in window && sections.length) {
			const spy = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						links.forEach((link) => {
							link.classList.toggle(
								'is-active',
								link.getAttribute('href') === `#${entry.target.id}`,
							);
						});
					});
				},
				{ rootMargin: '-40% 0px -52% 0px', threshold: 0 },
			);

			sections.forEach((section) => spy.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(253, 249, 244, 0.92);
		border-bottom: 1px solid transparent;
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.site-header.is-scrolled {
		border-color: var(--line-warm);
		box-shadow: 0 18px 40px -36px rgba(35, 39, 46, 0.45);
	}

	.header-inner {
		height: 78px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		padding: 7px 14px;
		border-radius: 999px;
		background: var(--ink);
	}

	.brand img {
		width: 112px;
		height: auto;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.nav-link {
		padding: 9px 13px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		color: #5d636e;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-link:hover {
		background: #fff;
		color: var(--ink);
	}

	.nav-link.is-active {
		color: var(--orange-deep);
		background: #fff4ea;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
	}

	.nav-toggle {
		display: none;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid var(--line-warm);
		background: #fff;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--ink);
	}

	.nav-toggle :global(svg) {
		width: 18px;
		height: 18px;
	}

	.nav-mobile {
		display: none;
		border-top: 1px solid var(--line-warm);
		background: var(--cream);
		padding: 12px 0 20px;
	}

	.nav-mobile.is-open {
		display: block;
	}

	.nav-mobile .container {
		display: grid;
		gap: 4px;
	}

	.nav-mobile a {
		padding: 12px 10px;
		border-radius: 12px;
		font-weight: 600;
		font-size: 15px;
	}

	.nav-mobile a:hover {
		background: #fff;
	}

	.nav-mobile :global(.btn) {
		margin-top: 8px;
	}

	@media (max-width: 900px) {
		.nav-desktop,
		.header-actions :global(.btn-ghost) {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 640px) {
		.header-inner {
			height: 68px;
		}

		.brand img {
			width: 86px;
			height: auto;
		}

		.header-actions :global(.btn-primary) {
			display: none;
		}
	}
</style>
