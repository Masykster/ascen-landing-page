<div
	class="cookie"
	id="cookie-banner"
	role="dialog"
	aria-live="polite"
	aria-label="Persetujuan cookie"
	hidden
>
	<p>
		Kami menggunakan cookie untuk statistik kunjungan anonim. Selengkapnya di <a
			href="https://ascendemy.id/kebijakan-privasi">Kebijakan Privasi</a
		>.
	</p>
	<div class="cookie-actions">
		<button type="button" data-cookie="declined">Tolak</button>
		<button type="button" class="accept" data-cookie="accepted">Terima</button>
	</div>
</div>

<script>
	const banner = document.getElementById('cookie-banner');

	if (banner) {
		const key = 'ascendemy-cookie-consent';
		let stored: string | null = null;

		try {
			stored = window.localStorage.getItem(key);
		} catch {
			stored = null;
		}

		if (stored) {
			banner.hidden = true;
		} else {
			window.setTimeout(() => {
				banner.hidden = false;
			}, 900);

			banner.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				const button = target.closest<HTMLElement>('[data-cookie]');
				if (!button) return;

				try {
					window.localStorage.setItem(key, button.dataset.cookie ?? '');
				} catch {
					/* storage can be unavailable */
				}

				banner.hidden = true;
			});
		}
	}
</script>

<style>
