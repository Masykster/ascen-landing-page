---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import unesa from '../../assets/images/Unesa.png';
import datanusa from '../../assets/images/Datanusa.png';
import qris from '../../assets/images/qris.png';
import { contactLines, socialLinks } from '../../data/site';
import {
	RIDGELINE_PRESETS,
	type RidgelinePalette,
	type RidgelinePreset,
} from '../../lib/ridgeline-dither';
import Icon from '../ui/Icon.astro';

interface Props {
	/** Colours. "polar" blends warm cream paper into polar glacier ridges. */
	preset?: RidgelinePreset;
	/** Colour overrides, merged over the preset. */
	palette?: Partial<RidgelinePalette>;
	/** Which range to generate. Any integer. */
	seed?: number;
	/** How many ridges recede into the mist, 2–9. Defaults to 6. */
	ridges?: number;
	/** Size of one dither pixel in CSS px. Defaults to 2. */
	pixel?: number;
	/** How thick the drifting mist is, 0–1. Defaults to 0.8. */
	mist?: number;
	/** Speed the mist drifts at. 0 holds it still. Defaults to 1. */
	drift?: number;
	/** Radius, in CSS px, of the clearing the pointer makes. Defaults to 130. */
	radius?: number;
	/** Pointer parallax, mist clearing and the click gust. Defaults to true. */
	interactive?: boolean;
	/** Read out the altitude of the crest under the pointer. Defaults to true. */
	altimeter?: boolean;
	/** Widest the framed content gets. Defaults to "1200px". */
	maxWidth?: string;
	/** Root minimum height. Defaults to "680px". */
	height?: string;
	/** Minimum height of the ridgeline canvas scene. Defaults to "260px". */
	sceneMinHeight?: string;
	/** Extra root class names. */
	class?: string;
}

const {
	preset = 'polar',
	palette,
	seed = 7,
	ridges = 6,
	pixel = 2,
	mist = 0.8,
	drift = 1,
	radius = 130,
	interactive = true,
	altimeter = true,
	maxWidth = '1200px',
	height = '680px',
	sceneMinHeight = '260px',
	class: className = '',
} = Astro.props;

const base =
	preset === 'auto'
		? RIDGELINE_PRESETS.evergreen
		: RIDGELINE_PRESETS[preset] ?? RIDGELINE_PRESETS.polar;
const colors: RidgelinePalette = { ...base, ...(palette ?? {}) };
const tones = colors.tones && colors.tones.length >= 2 ? colors.tones : base.tones;
const deep = tones[Math.max(1, tones.length - 2)] ?? colors.ink;
const accent = tones[Math.max(1, tones.length - 3)] ?? colors.ink;

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const resolveHref = (href: string) => (href.startsWith('#') && !isHome ? `/${href}` : href);

const learnLinks: { label: string; href: string; badge?: string }[] = [
	{ label: 'Latihan soal', href: '#latihan' },
	{ label: 'Tryout TKA', href: '#tryout' },
	{ label: 'Resource gratis', href: '/resource' },
	{ label: 'Semua paket', href: '#harga' },
	{ label: 'Blog', href: '/blog' },
];

const paymentLogos = [{ src: qris, alt: 'QRIS' }];

const rootStyle = [
	`min-height:${height}`,
	`--rdf-scene-min:${sceneMinHeight}`,
	`--rdf-paper:${colors.paper}`,
	`--rdf-ink:${colors.ink}`,
	`--rdf-muted:${colors.muted}`,
	`--rdf-line:${colors.line}`,
	`--rdf-heart:${colors.heart}`,
	`--rdf-deep:${deep}`,
	`--rdf-accent:${accent}`,
	`--rdf-max:${maxWidth}`,
	`--rdf-sans:var(--font-body)`,
	`--rdf-mono:var(--font-mono)`,
].join(';');
---

<footer
	id="footer"
	class:list={['rdf-root', className]}
	style={rootStyle}
	data-rdf-root
	data-rdf-preset={preset}
	data-rdf-seed={seed}
	data-rdf-ridges={ridges}
	data-rdf-pixel={pixel}
	data-rdf-mist={mist}
	data-rdf-drift={drift}
	data-rdf-radius={radius}
	data-rdf-interactive={String(interactive)}
	data-rdf-altimeter={String(altimeter)}
	data-rdf-tones={tones.join(',')}
>
	<div class="rdf-frame">
		<div class="rdf-top">
			<div class="rdf-brand">
				<a class="rdf-logo rdf-r" style="--d:140" href="/" aria-label="Ascendemy, kembali ke beranda">
					<Image
						src={logo}
						alt="Ascendemy"
						widths={[112, 224]}
						sizes="112px"
						format="webp"
						loading="lazy"
					/>
				</a>
				<p class="rdf-tag rdf-r" style="--d:230">
					Platform belajar, tryout, dan kompetisi untuk siswa Indonesia. Dikelola oleh Ascendemy
					bersama PIBT Unesa.
				</p>
				<ul class="rdf-social">
					{
						socialLinks.map((social, i) => (
							<li class="rdf-r" style={`--d:${310 + i * 50}`}>
								<a
									href={social.href}
									target="_blank"
									rel="noopener"
									aria-label={social.label}
								>
									<Icon name={social.icon} size={15} />
								</a>
							</li>
						))
					}
				</ul>
				<div class="rdf-partners rdf-r" style="--d:620">
					<a
						class="rdf-partner"
						href="https://unesa.ac.id/"
						target="_blank"
						rel="noopener"
						aria-label="Universitas Negeri Surabaya"
					>
						<Image
							src={unesa}
							alt="Universitas Negeri Surabaya"
							width={56}
							height={56}
							loading="lazy"
						/>
					</a>
					<a
						class="rdf-partner"
						href="https://sipensi.umkm.go.id/inkubators/11"
						target="_blank"
						rel="noopener"
						aria-label="Inkubator Bisnis Datanusa"
					>
						<Image
							src={datanusa}
							alt="Inkubator Bisnis Datanusa"
							width={56}
							height={56}
							loading="lazy"
						/>
					</a>
				</div>
			</div>

			<nav class="rdf-col" aria-label="Belajar">
				<h3 class="rdf-r" style="--d:260">Belajar</h3>
				<ul>
					{
						learnLinks.map((link, li) => (
							<li class="rdf-r" style={`--d:${330 + li * 55}`}>
								<a class="rdf-link" href={resolveHref(link.href)}>
									<span>{link.label}</span>
									{link.badge ? <span class="rdf-badge">{link.badge}</span> : null}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="rdf-col">
				<h3 class="rdf-r" style="--d:370">Kontak</h3>
				<ul class="rdf-contact-list">
					{
						contactLines.map((line, li) => (
							<li class="rdf-r" style={`--d:${440 + li * 55}`}>
								{line.href ? (
									<a
										class="rdf-link rdf-contact-link"
										href={line.href}
										target={line.external ? '_blank' : undefined}
										rel={line.external ? 'noopener' : undefined}
									>
										<Icon name={line.icon} size={14} />
										<span>{line.label}</span>
									</a>
								) : (
									<span class="rdf-contact-item">
										<Icon name={line.icon} size={14} />
										<span>{line.label}</span>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			<div class="rdf-col">
				<h3 class="rdf-r" style="--d:480">Pembayaran</h3>
				<p class="rdf-pay-note rdf-r" style="--d:550">
					Pembayaran aman melalui QRIS.
				</p>
				<div class="rdf-payments rdf-r" style="--d:620">
					{
						paymentLogos.map((payment) => (
							<span class="rdf-pay-chip">
								{payment.src.format === 'svg' ? (
									<img src={payment.src.src} alt={payment.alt} loading="lazy" />
								) : (
									<Image src={payment.src} alt={payment.alt} height={18} loading="lazy" />
								)}
							</span>
						))
					}
				</div>
			</div>
		</div>

		<div class="rdf-bar rdf-r" style="--d:1150">
			<p>© {year} Ascendemy. Seluruh hak cipta dilindungi.</p>
			<div class="rdf-legal">
				<a class="rdf-credit" href="/faq">FAQ</a>
				<span class="rdf-sep" aria-hidden="true">·</span>
				<a class="rdf-credit" href="/kebijakan-privasi">Kebijakan Privasi</a>
				<span class="rdf-sep" aria-hidden="true">·</span>
				<a class="rdf-credit" href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
			</div>
		</div>

		<div class="rdf-scene" data-rdf-scene>
			<canvas data-rdf-canvas aria-hidden="true"></canvas>
			<div class="rdf-alt" data-rdf-alt aria-hidden="true">
				<b></b>
				<i></i>
				<span data-rdf-alt-text></span>
			</div>
		</div>
	</div>
</footer>

<script>
	import '../../scripts/ridgeline-footer';
</script>

<style>
	.rdf-root {
		position: relative;
		display: grid;
		width: 100%;
		overflow: hidden;
		isolation: isolate;
		background: var(--rdf-paper);
		color: var(--rdf-ink);
		font-family: var(--rdf-sans);
		border-top: 1px solid var(--rdf-line);
		-webkit-font-smoothing: antialiased;
		--rdf-pad: clamp(20px, 3.2vw, 32px);
	}

	.rdf-frame {
		position: relative;
		display: grid;
		grid-template-rows: auto auto minmax(var(--rdf-scene-min), 1fr);
		width: 100%;
		max-width: var(--rdf-max);
		margin: 0 auto;
	}

	.rdf-frame::before,
	.rdf-frame::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		z-index: 3;
		pointer-events: none;
		background: var(--rdf-line);
		transform: scaleY(1);
		transform-origin: 50% 0;
		transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-frame::before {
		left: 0;
	}

	.rdf-frame::after {
		right: 0;
		transition-delay: 0.08s;
	}

	:global(.js) .rdf-frame::before,
	:global(.js) .rdf-frame::after {
		transform: scaleY(0);
	}

	:global(.js) .rdf-in .rdf-frame::before,
	:global(.js) .rdf-in .rdf-frame::after {
		transform: scaleY(1);
	}

	:global(.js) .rdf-r {
		opacity: 0;
		transform: translateY(12px);
		filter: blur(5px);
		transition:
			opacity 0.9s cubic-bezier(0.2, 0.7, 0.1, 1),
			transform 1s cubic-bezier(0.2, 0.7, 0.1, 1),
			filter 0.9s ease;
		transition-delay: calc(var(--d, 0) * 1ms);
	}

	:global(.js) .rdf-in .rdf-r {
		opacity: 1;
		transform: none;
		filter: none;
	}

	.rdf-top {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns:
			minmax(0, 1.4fr)
			minmax(0, 0.75fr)
			minmax(0, 1.25fr)
			minmax(0, 0.95fr);
		gap: 32px;
		padding: clamp(44px, 6.2vw, 76px) var(--rdf-pad) clamp(28px, 3.8vw, 48px);
	}

	.rdf-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
	}

	.rdf-logo {
		display: inline-flex;
		align-items: center;
		color: var(--rdf-ink);
		text-decoration: none;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-logo:hover {
		transform: translateY(-1px);
	}

	.rdf-logo :global(img) {
		width: 112px;
		height: auto;
	}

	.rdf-tag {
		margin: 0;
		max-width: 31ch;
		font-size: 13px;
		font-weight: 450;
		line-height: 1.6;
		color: var(--rdf-muted);
		text-wrap: pretty;
	}

	.rdf-social {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 2px 0 0 -7px;
		padding: 0;
		list-style: none;
	}

	.rdf-social a {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		color: var(--rdf-muted);
		transition:
			color 0.3s ease,
			background-color 0.3s ease,
			transform 0.45s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-social a:hover {
		color: var(--rdf-ink);
		background: color-mix(in srgb, var(--rdf-deep) 8%, transparent);
		transform: translateY(-2px);
	}

	.rdf-social :global(svg) {
		width: 15px;
		height: 15px;
		display: block;
	}

	.rdf-partners {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 2px;
	}

	.rdf-partner {
		display: inline-flex;
		align-items: center;
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-partner :global(img) {
		height: 26px;
		width: auto;
		opacity: 0.62;
		filter: grayscale(1);
		transition: opacity 0.3s ease, filter 0.3s ease;
	}

	.rdf-partner:hover {
		transform: translateY(-1px);
	}

	.rdf-partner:hover :global(img) {
		opacity: 0.92;
		filter: grayscale(0.2);
	}

	.rdf-col h3 {
		margin: 4px 0 18px;
		font: 600 10.5px/1 var(--rdf-mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rdf-muted);
	}

	.rdf-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 11px;
	}

	.rdf-link {
		position: relative;
		display: inline-flex;
		align-items: flex-start;
		gap: 8px;
		color: var(--rdf-ink);
		text-decoration: none;
		font-size: 13.5px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: -0.005em;
		transition:
			color 0.3s ease,
			transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-link::before {
		content: '';
		position: absolute;
		left: -12px;
		top: 0.68em;
		width: 7px;
		height: 1px;
		background: var(--rdf-accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-link:hover {
		color: var(--rdf-accent);
		transform: translateX(7px);
	}

	.rdf-link:hover::before {
		transform: scaleX(1);
	}

	.rdf-badge {
		font: 500 9px/1 var(--rdf-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 4px 6px 3px;
		border-radius: 99px;
		color: var(--rdf-accent);
		background: color-mix(in srgb, var(--rdf-accent) 11%, transparent);
	}

	.rdf-contact-list {
		gap: 12px !important;
	}

	.rdf-contact-link,
	.rdf-contact-item {
		font-size: 12.5px;
		line-height: 1.5;
	}

	.rdf-contact-item {
		display: inline-flex;
		align-items: flex-start;
		gap: 8px;
		color: var(--rdf-muted);
		font-weight: 450;
	}

	.rdf-contact-link :global(svg),
	.rdf-contact-item :global(svg) {
		width: 14px;
		height: 14px;
		flex: 0 0 auto;
		margin-top: 2px;
		color: var(--rdf-muted);
		transition: color 0.3s ease;
	}

	.rdf-contact-link:hover :global(svg) {
		color: var(--rdf-accent);
	}

	.rdf-pay-note {
		margin: 0;
		font-size: 12.5px;
		font-weight: 450;
		line-height: 1.55;
		color: var(--rdf-muted);
	}

	.rdf-payments {
		display: flex;
		align-items: center;
		gap: 7px;
		flex-wrap: wrap;
		margin-top: 14px;
	}

	.rdf-pay-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 3px 6px;
		border: 1px solid var(--rdf-line);
		border-radius: 5px;
		background: color-mix(in srgb, #ffffff 82%, var(--rdf-paper));
		transition:
			border-color 0.25s ease,
			transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.rdf-pay-chip:hover {
		border-color: color-mix(in srgb, var(--rdf-accent) 35%, var(--rdf-line));
		transform: translateY(-1px);
	}

	.rdf-pay-chip :global(img) {
		height: 16px;
		width: auto;
		display: block;
	}

	.rdf-link:focus-visible,
	.rdf-logo:focus-visible,
	.rdf-social a:focus-visible,
	.rdf-partner:focus-visible,
	.rdf-credit:focus-visible {
		outline: 1.5px solid var(--rdf-accent);
		outline-offset: 4px;
		border-radius: 3px;
	}

	.rdf-bar {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px 20px;
		padding: 8px var(--rdf-pad) 0;
		font-size: 12px;
		font-weight: 450;
		color: var(--rdf-muted);
	}

	.rdf-bar p {
		margin: 0;
	}

	.rdf-legal {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.rdf-sep {
		opacity: 0.55;
	}

	.rdf-credit {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--rdf-muted) 50%, transparent);
		text-underline-offset: 3px;
		transition:
			color 0.3s ease,
			text-decoration-color 0.3s ease;
	}

	.rdf-credit:hover {
		color: var(--rdf-ink);
		text-decoration-color: currentColor;
	}

	.rdf-scene {
		position: relative;
		z-index: 1;
		margin-top: -64px;
		overflow: hidden;
	}

	.rdf-scene canvas {
		position: absolute;
		left: 0;
		bottom: 0;
		display: block;
		max-width: none;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.rdf-alt {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 2;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.35s ease;
		font: 500 10px/1 var(--rdf-mono);
		letter-spacing: 0.08em;
		color: var(--rdf-ink);
	}

	.rdf-alt i {
		position: absolute;
		left: -4px;
		top: -4px;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--rdf-paper);
		box-shadow: 0 0 0 1.5px var(--rdf-ink);
	}

	.rdf-alt b {
		position: absolute;
		left: -0.5px;
		bottom: 6px;
		width: 1px;
		height: 26px;
		background: var(--rdf-ink);
		opacity: 0.55;
	}

	.rdf-alt span {
		position: absolute;
		left: 0;
		bottom: 34px;
		transform: translateX(-50%);
		white-space: nowrap;
		padding: 5px 7px 4px;
		border-radius: 5px;
		background: color-mix(in srgb, var(--rdf-paper) 88%, transparent);
		box-shadow: 0 0 0 1px var(--rdf-line);
		-webkit-backdrop-filter: blur(4px);
		backdrop-filter: blur(4px);
	}

	@media (max-width: 980px) {
		.rdf-top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 36px 28px;
		}
	}

	@media (max-width: 640px) {
		.rdf-top {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 30px;
		}

		.rdf-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 6px;
		}

		.rdf-scene {
			margin-top: -40px;
		}
	}

	@media print {
		:global(.js) .rdf-r {
			opacity: 1 !important;
			transform: none !important;
			filter: none !important;
		}

		:global(.js) .rdf-frame::before,
		:global(.js) .rdf-frame::after {
			transform: scaleY(1) !important;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .rdf-r,
		:global(.js) .rdf-frame::before,
		:global(.js) .rdf-frame::after,
		.rdf-link,
		.rdf-link::before,
		.rdf-social a,
		.rdf-logo,
		.rdf-partner,
		.rdf-pay-chip {
			transition: none !important;
		}

		:global(.js) .rdf-r {
			opacity: 1 !important;
			transform: none !important;
			filter: none !important;
		}

		:global(.js) .rdf-frame::before,
		:global(.js) .rdf-frame::after {
			transform: scaleY(1) !important;
		}
	}
</style>
