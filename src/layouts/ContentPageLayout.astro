---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	eyebrow?: string;
	description: string;
	intro?: string;
	updated?: string;
	current: '/faq' | '/kebijakan-privasi' | '/syarat-ketentuan';
}

const { title, eyebrow = 'Bantuan', description, intro, updated, current } = Astro.props;

const related = [
	{ label: 'FAQ', href: '/faq' },
	{ label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
	{ label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
].filter((link) => link.href !== current);
---

<BaseLayout title={`${title} — Ascendemy`} description={description}>
	<Header />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<p class="eyebrow reveal">{eyebrow}</p>
				<h1 class="reveal">{title}</h1>
				{updated && <p class="updated reveal">Terakhir diperbarui: {updated}</p>}
				{intro && <p class="lede reveal">{intro}</p>}
			</div>
		</section>

		<section class="page-body">
			<div class="container">
				<article class="prose">
					<slot />
				</article>

				<nav class="related reveal" aria-label="Halaman bantuan lainnya">
					<span>Bantuan lainnya</span>
					<ul>
						{related.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.page-hero {
		position: relative;
		padding: clamp(64px, 8.5vw, 108px) 0 clamp(44px, 5.5vw, 68px);
		background:
			radial-gradient(760px 360px at 88% -20%, rgba(249, 115, 22, 0.08), transparent 70%),
			var(--cream);
		border-bottom: 1px solid var(--line-warm);
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--orange-deep);
	}

	.page-hero h1 {
		margin: 18px 0 0;
		font-family: var(--font-display);
		font-size: clamp(40px, 5.6vw, 68px);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.045em;
		color: var(--ink);
		text-wrap: balance;
	}

	.updated {
		margin: 18px 0 0;
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.lede {
		margin: 18px 0 0;
		font-size: 16.5px;
		line-height: 1.65;
		color: var(--muted);
		text-wrap: pretty;
	}

	.page-body {
		padding: clamp(48px, 6.5vw, 80px) 0 clamp(72px, 9vw, 104px);
	}

	.prose {
		width: 100%;
	}

	.prose :global(h2) {
		margin: 44px 0 14px;
		padding-top: 30px;
		border-top: 1px solid var(--line-warm);
		font-family: var(--font-display);
		font-size: clamp(22px, 2.5vw, 28px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.025em;
		color: var(--ink);
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	.prose :global(p) {
		margin: 0 0 14px;
		font-size: 15px;
		line-height: 1.75;
		color: var(--text);
	}

	.prose :global(ul),
	.prose :global(ol) {
		display: grid;
		gap: 8px;
		margin: 0 0 18px;
		padding-left: 20px;
	}

	.prose :global(li) {
		font-size: 15px;
		line-height: 1.7;
		color: var(--text);
	}

	.prose :global(li::marker) {
		color: var(--orange);
	}

	.prose :global(strong) {
		font-weight: 700;
		color: var(--ink);
	}

	.prose :global(a) {
		color: var(--orange-deep);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: rgba(234, 88, 12, 0.35);
		text-underline-offset: 3px;
	}

	.prose :global(a:hover) {
		color: var(--orange);
		text-decoration-color: currentColor;
	}

	.related {
		width: 100%;
		margin-top: 56px;
		padding-top: 26px;
		border-top: 1px solid var(--line-warm);
	}

	.related > span {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.related ul {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.related a {
		font-size: 13.5px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: #d9d0c5;
		text-underline-offset: 3px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.related a:hover {
		color: var(--orange-deep);
		text-decoration-color: currentColor;
	}

	@media (max-width: 640px) {
		.page-hero {
			padding-top: 48px;
		}
	}
</style>
