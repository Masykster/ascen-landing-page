---
import '../styles/fonts.css';
import '../styles/global.css';
import CookieBanner from '../components/layout/CookieBanner.astro';
import IconSprite from '../components/ui/IconSprite.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Ascendemy — Latihan, Tryout, dan Kompetisi untuk Siswa Indonesia',
	description = 'Tingkatkan kompetensi dengan Computer Based Test. Latihan soal, tryout TKA, dan olimpiade matematika dalam satu platform bersama Ascendemy.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fdf9f4" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Lompat ke konten</a>
		<IconSprite />
		<slot />
		<CookieBanner />

		<script>
			// Stagger otomatis: container bertanda [data-stagger] memberi delay per anak reveal
			document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((container) => {
				const children = Array.from(container.children) as HTMLElement[];
				children
					.filter((child) => child.classList.contains('reveal'))
					.forEach((child, index) => {
						child.style.setProperty('--reveal-delay', `${Math.min(index * 80, 360)}ms`);
					});
			});

			const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Arrival emphasis: tandai section tujuan sebentar saat anchor diklik
			let pendingArrival: HTMLElement | null = null;

			const triggerArrival = (section: HTMLElement) => {
				section.classList.remove('is-arriving');
				void section.offsetWidth; // reflow supaya animasi bisa diputar ulang
				section.classList.add('is-arriving');
				window.setTimeout(() => section.classList.remove('is-arriving'), 1600);
			};

			if (items.length) {
				if (reduceMotion || !('requestAnimationFrame' in window)) {
					items.forEach((item) => item.classList.add('is-visible'));
				} else {
					// Sweep berbasis scroll: lebih aman daripada IntersectionObserver,
					// yang bisa "melewati" elemen saat user scroll cepat atau loncat anchor.
					const pending = new Set(items);

					const sweep = () => {
						const limit = window.innerHeight * 0.92;
						pending.forEach((item) => {
							const rect = item.getBoundingClientRect();
							if (rect.top < limit) {
								pending.delete(item);
								item.classList.add('is-visible');
							}
						});

						// Arrival cukup dipancing saat section tujuan benar-benar masuk layar
						if (pendingArrival) {
							const rect = pendingArrival.getBoundingClientRect();
							if (rect.top < window.innerHeight * 0.3) {
								triggerArrival(pendingArrival);
								pendingArrival = null;
							}
						}
					};

					let ticking = false;
					const onScroll = () => {
						if (ticking) return;
						ticking = true;
						window.requestAnimationFrame(() => {
							sweep();
							ticking = false;
						});
					};

					window.addEventListener('scroll', onScroll, { passive: true });
					window.addEventListener('resize', onScroll, { passive: true });
					sweep();
				}
			}

			const pauseSections = Array.from(
				document.querySelectorAll<HTMLElement>('[data-pause-offscreen]'),
			);

			if (pauseSections.length && 'IntersectionObserver' in window) {
				const pauseObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							entry.target.classList.toggle('is-offscreen', !entry.isIntersecting);
						});
					},
					{ rootMargin: '160px 0px' },
				);

				pauseSections.forEach((section) => pauseObserver.observe(section));
			}

			document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
				link.addEventListener('click', () => {
					const id = link.getAttribute('href')?.slice(1);
					if (!id) return;

					const target = document.getElementById(id);
					if (!target || target.tagName !== 'SECTION') return;

					// Kalau section sudah terlihat, langsung picu; kalau tidak, tunggu scroll selesai.
					const rect = target.getBoundingClientRect();
					if (rect.top < window.innerHeight * 0.3) {
						triggerArrival(target);
						pendingArrival = null;
					} else {
						pendingArrival = target;
					}
				});
			});
		</script>
	</body>
</html>
